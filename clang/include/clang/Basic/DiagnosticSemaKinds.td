// Unsafe buffer usage diagnostics.
def warn_unsafe_buffer_variable : Warning<
  "%0 is an %select{unsafe pointer used for buffer access|unsafe buffer that "
  "does not perform bounds checks}1"
  "\n" "警告：%0 是%select{用于缓冲访问的不安全指针|不执行边界检查的不安全缓冲}1">,
  InGroup<UnsafeBufferUsage>, DefaultIgnore;
def warn_unsafe_buffer_operation : Warning<
  "%select{unsafe pointer operation|unsafe pointer arithmetic|"
  "unsafe buffer access|function introduces unsafe buffer manipulation|unsafe invocation of %1|"
  "field %1 prone to unsafe buffer manipulation}0"
  "\n" "警告：%select{不安全指针操作|不安全指针算术|"
  "不安全缓冲访问|函数引入不安全缓冲操作|对 %1 的不安全调用|"
  "易于不安全缓冲操作的字段 %1}0">,
  InGroup<UnsafeBufferUsage>, DefaultIgnore;
def warn_unsafe_buffer_libc_call : Warning<
  "function %0 is unsafe"
  "\n" "警告：函数 %0 是不安全的">,
  InGroup<UnsafeBufferUsageInLibcCall>, DefaultIgnore;
def warn_unsafe_buffer_format_attr_call : Warning<
  "formatting function %0 is unsafe"
  "\n" "警告：格式化函数 %0 是不安全的">,
  InGroup<UnsafeBufferUsageInFormatAttrCall>, DefaultIgnore;

def note_unsafe_buffer_printf_call : Note<
  "%select{|change to 'snprintf' for explicit bounds checking | buffer pointer and size may not match"
          "|string argument is not guaranteed to be null-terminated"
          "|'va_list' is unsafe}0"
  "\n" "提示：%select{|改为 'snprintf' 以进行显式边界检查 |缓冲指针和大小可能不匹配"
          "|字符串实参不保证以 null 结尾"
          "|'va_list' 是不安全的}0">;
def note_unsafe_buffer_operation : Note<
  "used%select{| in pointer arithmetic| in buffer access}0 here"
  "\n" "提示：在此处%select{|在指针算术中|在缓冲访问中}0使用">;
def note_unsafe_buffer_variable_fixit_group : Note<
  "change type of %0 to '%select{std::span' to preserve bounds information|std::array' to label it for hardening|std::span::iterator' to preserve bounds information}1%select{|, and change %2 to '%select{std::span|std::array|std::span::iterator}1' to propagate bounds information between them}3"
  "\n" "提示：将 %0 的类型更改为 '%select{std::span 以保留边界信息|std::array 以标记其用于加固|std::span::iterator 以保留边界信息}1%select{|，并将 %2 更改为 '%select{std::span|std::array|std::span::iterator}1' 以在它们之间传播边界信息}3">;
def note_unsafe_buffer_variable_fixit_together : Note<
  "change type of %0 to '%select{std::span' to preserve bounds information|std::array' to label it for hardening|std::span::iterator' to preserve bounds information}1"
  "%select{|, and change %2 to safe types to make function %4 bounds-safe}3"
  "\n" "提示：将 %0 的类型更改为 '%select{std::span 以保留边界信息|std::array 以标记其用于加固|std::span::iterator 以保留边界信息}1"
  "%select{|，并将 %2 更改为安全类型以使函数 %4 具有边界安全}3">;
def note_safe_buffer_usage_suggestions_disabled : Note<
  "pass -fsafe-buffer-usage-suggestions to receive code hardening suggestions"
  "\n" "提示：传递 -fsafe-buffer-usage-suggestions 以接收代码加固建议">;
def warn_unsafe_buffer_usage_in_container : Warning<
  "the two-parameter std::span construction is unsafe as it can introduce mismatch between buffer size and the bound information"
  "\n" "警告：双形参 std::span 构造是不安全的，因为它可能引入缓冲大小与边界信息之间的不匹配">,
  InGroup<UnsafeBufferUsageInContainer>, DefaultIgnore;
def warn_unsafe_buffer_usage_unique_ptr_array_access : Warning<"direct access using operator[] on std::unique_ptr<T[]> is unsafe due to lack of bounds checking"
  "\n" "警告：由于缺少边界检查，在 std::unique_ptr<T[]> 上使用 operator[] 的直接访问是不安全的">,
  InGroup<UnsafeBufferUsageInUniquePtrArrayAccess>, DefaultIgnore;
def warn_unsafe_buffer_usage_in_static_sized_array : Warning<"direct access on T[N] is unsafe due to the lack of bounds checking"
  "\n" "警告：由于缺少边界检查，对 T[N] 的直接访问是不安全的">,
  InGroup<UnsafeBufferUsageInStaticSizedArray>, DefaultIgnore;
