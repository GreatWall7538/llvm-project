  "\n" "警告：替换函数 %0 不能声明为 'inline'">,
  InGroup<DiagGroup<"inline-new-delete">>;
def err_operator_new_delete_invalid_result_type : Error<
  "%0 must return type %1"
  "\n" "错误：%0 必须返回类型 %1">;
def err_operator_new_delete_dependent_result_type : Error<
  "%0 cannot have a dependent return type; use %1 instead"
  "\n" "错误：%0 不能具有依赖的返回类型；请改用 %1">;
def err_operator_new_delete_too_few_parameters : Error<
  "%select{|type aware }0%select{|destroying }1%2 must have at least %select{|one|two|three|four|five}3 parameter%s3"
  "\n" "错误：%select{|类型感知的 }0%select{|销毁 }1%2 必须至少有%select{|一|二|三|四|五}3个形参%s3">;
def err_operator_new_delete_template_too_few_parameters : Error<
  "%0 template must have at least two parameters"
  "\n" "错误：%0 模板必须至少有两个形参">;
def warn_operator_new_returns_null : Warning<
