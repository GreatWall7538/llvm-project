  "it with the \".\" operator?"
  "\n" "错误：在类型 %1 的对象上找到属性 %0；您是指使用 "
  " \".\" 运算符访问它吗？">;
def err_undef_interface_suggest : Error<
  "cannot find interface declaration for %0; did you mean %1?"
  "\n" "错误：找不到 %0 的接口声明；您是指 %1 吗？">;
def warn_undef_interface_suggest : Warning<
  "cannot find interface declaration for %0; did you mean %1?"
  "\n" "警告：找不到 %0 的接口声明；您是指 %1 吗？">;
def err_undef_superclass_suggest : Error<
  "cannot find interface declaration for %0, superclass of %1; did you mean "
  "%2?"
  "\n" "错误：找不到 %0（%1 的父类）的接口声明；您是指 "
  "%2 吗？">;
def err_undeclared_protocol_suggest : Error<
  "cannot find protocol declaration for %0; did you mean %1?"
  "\n" "错误：找不到 %0 的协议声明；您是指 %1 吗？">;
def note_base_class_specified_here : Note<
  "base class %0 specified here"
  "\n" "提示：基类 %0 在此处指定">;
def err_using_directive_suggest : Error<
  "no namespace named %0; did you mean %1?"
  "\n" "错误：没有名为 %0 的命名空间；您是指 %1 吗？">;
def err_using_directive_member_suggest : Error<
  "no namespace named %0 in %1; did you mean %select{|simply }2%3?"
  "\n" "错误：%1 中没有名为 %0 的命名空间；您是指%select{|直接}2 %3 吗？">;
def note_namespace_defined_here : Note<"namespace %0 defined here"
  "\n" "提示：命名空间 %0 在此定义">;
def err_sizeof_pack_no_pack_name_suggest : Error<
  "%0 does not refer to the name of a parameter pack; did you mean %1?"
  "\n" "错误：%0 未引用参数包的名称；您是指 %1 吗？">;
def note_parameter_pack_here : Note<"parameter pack %0 declared here"
  "\n" "提示：参数包 %0 在此声明">;

def err_uncasted_use_of_unknown_any : Error<
  "%0 has unknown type; cast it to its declared type to use it"
  "\n" "错误：%0 具有未知类型；请将其转换为其声明的类型以使用它">;
def err_uncasted_call_of_unknown_any : Error<
  "%0 has unknown return type; cast the call to its declared return type"
  "\n" "错误：%0 具有未知的返回类型；请将该调用转换为其声明的返回类型">;
def err_uncasted_send_to_unknown_any_method : Error<
  "no known method %select{%objcinstance1|%objcclass1}0; cast the "
  "message send to the method's return type"
  "\n" "错误：没有已知的方法%select{%objcinstance1|%objcclass1}0；请将 "
  "消息发送转换到方法的返回类型">;
def err_unsupported_unknown_any_decl : Error<
  "%0 has unknown type, which is not supported for this kind of declaration"
  "\n" "错误：%0 具有未知类型，此声明类型不支持该类型">;
def err_unsupported_unknown_any_expr : Error<
  "unsupported expression with unknown type"
  "\n" "错误：不支持具有未知类型的表达式">;
def err_unsupported_unknown_any_call : Error<
  "call to unsupported expression with unknown type"
  "\n" "错误：调用具有未知类型的不支持的表达式">;
def err_unknown_any_addrof : Error<
  "the address of a declaration with unknown type "
  "can only be cast to a pointer type"
  "\n" "错误：具有未知类型的声明的地址 "
  "只能转换为指针类型">;
def err_unknown_any_addrof_call : Error<
  "address-of operator cannot be applied to a call to a function with "
  "unknown return type"
  "\n" "错误：取地址运算符不能应用于对具有 "
  "未知返回类型的函数的调用">;
def err_unknown_any_var_function_type : Error<
  "variable %0 with unknown type cannot be given a function type"
  "\n" "错误：不能为具有未知类型的变量 %0 指定函数类型">;
def err_unknown_any_function : Error<
  "function %0 with unknown type must be given a function type"
  "\n" "错误：必须为具有未知类型的函数 %0 指定函数类型">;

def err_filter_expression_integral : Error<
  "filter expression has non-integral type %0"
  "\n" "错误：过滤器表达式具有非整数类型 %0">;

def err_non_asm_stmt_in_naked_function : Error<
  "non-ASM statement in naked function is not supported"
  "\n" "错误：裸函数中的非 ASM 语句不受支持">;
def err_asm_naked_this_ref : Error<
  "'this' pointer references not allowed in naked functions"
  "\n" "错误：裸函数中不允许 'this' 指针引用">;
def err_asm_naked_parm_ref : Error<
  "parameter references not allowed in naked functions"
  "\n" "错误：裸函数中不允许形参引用">;

// OpenCL warnings and errors.
def err_invalid_astype_of_different_size : Error<
  "invalid reinterpretation: sizes of %0 and %1 must match"
  "\n" "错误：无效的重新解释：%0 和 %1 的大小必须匹配">;
def err_static_kernel : Error<
  "kernel functions cannot be declared static"
  "\n" "错误：内核函数不能声明为 static">;
def err_method_kernel : Error<
  "kernel functions cannot be class members"
  "\n" "错误：内核函数不能是类成员">;
def err_template_kernel : Error<
  "kernel functions cannot be used in a template declaration, instantiation or specialization"
  "\n" "错误：内核函数不能在模板声明、实例化或特化中使用">;
def err_opencl_ptrptr_kernel_param : Error<
  "kernel parameter cannot be declared as a pointer to a pointer"
  "\n" "错误：内核形参不能声明为指向指针的指针">;
def err_kernel_arg_address_space : Error<
  "pointer arguments to kernel functions must reside in '__global', "
  "'__constant' or '__local' address space"
  "\n" "错误：内核函数的指针实参必须位于 '__global'、 "
  "'__constant' 或 '__local' 地址空间中">;
def err_opencl_ext_vector_component_invalid_length : Error<
  "vector component access has invalid length %0; supported lengths are: 1,2,3,4,8,16"
  "\n" "错误：向量分量访问具有无效长度 %0；支持的长度为：1、2、3、4、8、16">;
def err_opencl_function_variable : Error<
  "%select{non-kernel function|function scope}0 variable cannot be declared in %1 address space"
  "\n" "错误：%select{非内核函数|函数作用域}0变量不能在 %1 地址空间中声明">;
def err_opencl_addrspace_scope : Error<
  "variables in the %0 address space can only be declared in the outermost "
  "scope of a kernel function"
  "\n" "错误：%0 地址空间中的变量只能在内核函数的最外层 "
  "作用域中声明">;
def err_static_function_scope : Error<
  "variables in function scope cannot be declared static"
  "\n" "错误：函数作用域中的变量不能声明为 static">;
def err_opencl_bitfields : Error<
  "bit-fields are not supported in OpenCL"
  "\n" "错误：OpenCL 不支持位域">;
def err_opencl_vla : Error<
  "variable length arrays are not supported in OpenCL"
  "\n" "错误：OpenCL 不支持可变长度数组">;
def err_opencl_scalar_type_rank_greater_than_vector_type : Error<
    "scalar operand type has greater rank than the type of the vector "
    "element. (%0 and %1)"
  "\n" "错误：标量操作数类型的秩大于向量 "
    "元素的类型。（%0 和 %1）">;
def err_bad_kernel_param_type : Error<
  "%0 cannot be used as the type of a kernel parameter"
  "\n" "错误：%0 不能用作内核形参的类型">;
def err_record_with_pointers_kernel_param : Error<
  "%select{struct|union}0 kernel parameters may not contain pointers"
  "\n" "错误：%select{struct|union}0内核形参不能包含指针">;
def note_within_field_of_type : Note<
  "within field of type %0 declared here"
  "\n" "提示：在类型 %0 的字段内，在此声明">;
def note_within_capture : Note<
  "within capture %0 of lambda expression here"
  "\n" "提示：在此处 lambda 表达式的捕获 %0 内">;
def note_within_base_of_type : Note<
  "within base class of type %0 declared here"
  "\n" "提示：在类型 %0 的基类内，在此声明">;
def note_within_param_of_type : Note<
  "within parameter %0 of type %1 declared here"
  "\n" "提示：在类型 %1 的形参 %0 内，在此声明">;
def note_illegal_field_declared_here : Note<
  "field of illegal %select{type|pointer type}0 %1 declared here"
  "\n" "提示：非法%select{类型|指针类型}0 %1 的字段在此声明">;
def err_opencl_type_struct_or_union_field : Error<
  "the %0 type cannot be used to declare a structure or union field"
  "\n" "错误：%0 类型不能用于声明结构或联合字段">;
def err_event_t_addr_space_qual : Error<
  "the event_t type can only be used with __private address space qualifier"
  "\n" "错误：event_t 类型只能与 __private 地址空间限定符一起使用">;
def err_expected_kernel_void_return_type : Error<
  "kernel must have void return type"
  "\n" "错误：内核必须具有 void 返回类型">;
def err_sampler_initializer_not_integer : Error<
  "sampler_t initialization requires 32-bit integer, not %0"
  "\n" "错误：sampler_t 初始化需要 32 位整数，而不是 %0">;
def warn_sampler_initializer_invalid_bits : Warning<
  "sampler initializer has invalid %0 bits"
  "\n" "警告：采样器初始化器具有无效的 %0 位">, InGroup<SpirCompat>, DefaultIgnore;
def warn_sampler_argument_invalid_filter : Warning<
  "'%0' sampler must use CLK_FILTER_NEAREST"
  "\n" "警告：'%0' 采样器必须使用 CLK_FILTER_NEAREST">, InGroup<SpirCompat>;
def err_sampler_argument_required : Error<
  "sampler_t variable required - got %0"
  "\n" "错误：需要 sampler_t 变量 - 得到 %0">;
def err_wrong_sampler_addressspace: Error<
  "sampler type cannot be used with the __local and __global address space qualifiers"
  "\n" "错误：sampler 类型不能与 __local 和 __global 地址空间限定符一起使用">;
def err_opencl_nonconst_global_sampler : Error<
  "global sampler requires a const or constant address space qualifier"
  "\n" "错误：全局采样器需要 const 或 constant 地址空间限定符">;
def err_opencl_cast_non_zero_to_event_t : Error<
  "cannot cast non-zero value '%0' to 'event_t'"
  "\n" "错误：不能将非零值 '%0' 转换为 'event_t'">;
def err_opencl_global_invalid_addr_space : Error<
  "%select{program scope|static local|extern}0 variable must reside in %1 address space"
  "\n" "错误：%select{程序作用域|static 局部|extern}0变量必须位于 %1 地址空间中">;
def err_missing_actual_pipe_type : Error<
  "missing actual type specifier for pipe"
  "\n" "错误：管道缺少实际类型说明符">;
def err_reference_pipe_type : Error <
  "pipes packet types cannot be of reference type"
  "\n" "错误：管道数据包类型不能是引用类型">;
def err_opencl_no_main : Error<"%select{function|kernel}0 cannot be called 'main'"
  "\n" "错误：%select{函数|内核}0不能称为 'main'">;
def err_opencl_kernel_attr :
  Error<"attribute %0 can only be applied to an OpenCL kernel function"
  "\n" "错误：特性 %0 只能应用于 OpenCL 内核函数">;
def err_return_value_with_address_space : Error<
  "return type cannot be qualified with address space"
  "\n" "错误：返回类型不能用地址空间限定">;
def err_opencl_constant_no_init : Error<
  "variable in constant address space must be initialized"
  "\n" "错误：constant 地址空间中的变量必须被初始化">;
def err_opencl_atomic_init: Error<
  "atomic variable can be %select{assigned|initialized}0 to a variable only "
  "in global address space"
  "\n" "错误：原子变量只能在全局地址空间中%select{赋值给|初始化为}0变量">;
def err_opencl_implicit_vector_conversion : Error<
  "implicit conversions between vector types (%0 and %1) are not permitted"
  "\n" "错误：不允许在向量类型（%0 和 %1）之间进行隐式转换">;
def err_opencl_invalid_type_array : Error<
  "array of %0 type is invalid in OpenCL"
  "\n" "错误：%0 类型的数组在 OpenCL 中无效">;
def err_opencl_ternary_with_block : Error<
  "block type cannot be used as expression in ternary expression in OpenCL"
  "\n" "错误：block 类型不能在 OpenCL 的三元表达式中用作表达式">;
def err_opencl_pointer_to_type : Error<
  "pointer to type %0 is invalid in OpenCL"
  "\n" "错误：指向类型 %0 的指针在 OpenCL 中无效">;
def err_opencl_type_can_only_be_used_as_function_parameter : Error <
  "type %0 can only be used as a function parameter in OpenCL"
  "\n" "错误：类型 %0 在 OpenCL 中只能用作函数形参">;
def err_opencl_type_not_found : Error<
  "%0 type %1 not found; include the base header with -finclude-default-header"
  "\n" "错误：未找到 %0 类型 %1；使用 -finclude-default-header 包含基础头文件">;
def warn_opencl_attr_deprecated_ignored : Warning <
  "%0 attribute is deprecated and ignored in %1"
  "\n" "警告：%0 特性在 %1 中已弃用并被忽略">, InGroup<IgnoredAttributes>;
def warn_deprecated_attribute : Warning<
  "'%0' attribute is deprecated and may be removed in a future version of Clang"
  "\n" "警告：'%0' 特性已弃用，并可能在 Clang 的未来版本中被移除">,
  InGroup<DeprecatedAttributes>;
def err_opencl_variadic_function : Error<
  "invalid prototype, variadic arguments are not allowed in OpenCL"
  "\n" "错误：无效的原型，OpenCL 中不允许可变参数">;
def err_opencl_requires_extension : Error<
  "use of %select{type|declaration}0 %1 requires %2 support"
  "\n" "错误：使用%select{类型|声明}0 %1 需要 %2 支持">;
def ext_opencl_double_without_pragma : Extension<
  "Clang permits use of type 'double' regardless pragma if 'cl_khr_fp64' is"
  " supported"
  "\n" "警告：如果 'cl_khr_fp64' 受支持，"
  "则无论 pragma 如何，Clang 都允许使用 'double' 类型">;
def warn_opencl_longlong : Warning<
  "'long long' is a reserved data type in OpenCL C"
  "\n" "警告：'long long' 是 OpenCL C 中的保留数据类型">,
  InGroup<ReservedIdentifier>;
def warn_opencl_generic_address_space_arg : Warning<
  "passing non-generic address space pointer to %0"
  " may cause dynamic conversion affecting performance"
  "\n" "警告：将非通用地址空间指针传递给 %0"
  " 可能导致影响性能的动态转换">,
  InGroup<Conversion>, DefaultIgnore;

// OpenCL v2.0 s6.13.6 -- Builtin Pipe Functions
def err_opencl_builtin_pipe_first_arg : Error<
  "first argument to %0 must be a pipe type"
  "\n" "错误：%0 的第一个实参必须是管道类型">;
def err_opencl_builtin_pipe_arg_num : Error<
  "invalid number of arguments to function: %0"
  "\n" "错误：函数的实参数量无效：%0">;
def err_opencl_builtin_pipe_invalid_arg : Error<
  "invalid argument type to function %0 (expecting %1 having %2)"
  "\n" "错误：函数 %0 的实参类型无效（期望 %1 具有 %2）">;
def err_opencl_builtin_pipe_invalid_access_modifier : Error<
  "invalid pipe access modifier (expecting %0)"
  "\n" "错误：无效的管道访问修饰符（期望 %0）">;

// OpenCL access qualifier
def err_opencl_invalid_access_qualifier : Error<
  "access qualifier can only be used for pipe and image type"
  "\n" "错误：访问限定符只能用于管道和图像类型">;
def err_opencl_invalid_read_write : Error<
  "access qualifier %0 cannot be used for %1 %select{|prior to OpenCL C version 2.0 or in version 3.0 "
  "and without __opencl_c_read_write_images feature}2"
  "\n" "错误：访问限定符 %0 不能用于 %1%select{|在 OpenCL C 版本 2.0 之前或在版本 3.0 中 "
  "且没有 __opencl_c_read_write_images 特性}2">;
def err_opencl_multiple_access_qualifiers : Error<
  "multiple access qualifiers"
  "\n" "错误：多个访问限定符">;
def note_opencl_typedef_access_qualifier : Note<
  "previously declared '%0' here"
  "\n" "提示：先前在此声明 '%0'">;

// OpenCL v2.0 s6.12.5 Blocks restrictions
def err_opencl_block_storage_type : Error<
  "the __block storage type is not permitted"
  "\n" "错误：不允许 __block 存储类型">;
def err_opencl_invalid_block_declaration : Error<
  "invalid block variable declaration - must be %select{const qualified|initialized}0"
  "\n" "错误：无效的块变量声明 - 必须%select{是 const 限定的|被初始化}0">;
def err_opencl_extern_block_declaration : Error<
  "invalid block variable declaration - using 'extern' storage class is disallowed"
  "\n" "错误：无效的块变量声明 - 不允许使用 'extern' 存储类">;
def err_opencl_block_ref_block : Error<
  "cannot refer to a block inside block"
  "\n" "错误：不能在块内部引用块">;

// OpenCL v2.0 s6.13.9 - Address space qualifier functions.
def err_opencl_builtin_to_addr_invalid_arg : Error<
  "invalid argument %0 to function: %1, expecting a generic pointer argument"
  "\n" "错误：函数 %1 的实参 %0 无效，期望通用指针实参">;

// OpenCL v2.0 s6.13.17 Enqueue kernel restrictions.
def err_opencl_enqueue_kernel_incorrect_args : Error<
  "illegal call to enqueue_kernel, incorrect argument types"
  "\n" "错误：对 enqueue_kernel 的非法调用，实参类型不正确">;
def err_opencl_enqueue_kernel_local_size_args : Error<
  "mismatch in number of block parameters and local size arguments passed"
  "\n" "错误：传递的块形参数量与局部大小实参数量不匹配">;
def err_opencl_enqueue_kernel_invalid_local_size_type : Error<
  "illegal call to enqueue_kernel, parameter needs to be specified as integer type"
  "\n" "错误：对 enqueue_kernel 的非法调用，形参需要指定为整数类型">;
def err_opencl_enqueue_kernel_blocks_non_local_void_args : Error<
  "blocks used in enqueue_kernel call are expected to have parameters of type 'local void*'"
  "\n" "错误：enqueue_kernel 调用中使用的块应具有 'local void*' 类型的形参">;
def err_opencl_enqueue_kernel_blocks_no_args : Error<
  "blocks with parameters are not accepted in this prototype of enqueue_kernel call"
  "\n" "错误：此 enqueue_kernel 调用原型不接受带形参的块">;

def err_opencl_builtin_expected_type : Error<
  "illegal call to %0, expected %1 argument type"
  "\n" "错误：对 %0 的非法调用，期望 %1 实参类型">;

// OpenCL v3.0 s6.3.7 - Vector Components
def ext_opencl_ext_vector_type_rgba_selector: ExtWarn<
  "vector component name '%0' is a feature from OpenCL version 3.0 onwards"
  "\n" "警告：向量分量名称 '%0' 是 OpenCL 3.0 及更高版本中的特性">,
  InGroup<OpenCLUnsupportedRGBA>;

def err_openclcxx_placement_new : Error<
  "use of placement new requires explicit declaration"
  "\n" "错误：使用 placement new 需要显式声明">;

// MIG routine annotations.
def warn_mig_server_routine_does_not_return_kern_return_t : Warning<
  "'mig_server_routine' attribute only applies to routines that return a kern_return_t"
  "\n" "警告：'mig_server_routine' 特性仅适用于返回 kern_return_t 的例程">,
  InGroup<IgnoredAttributes>;

def warn_imp_cast_drops_unaligned : Warning<
  "implicit cast from type %0 to type %1 drops __unaligned qualifier"
  "\n" "警告：从类型 %0 到类型 %1 的隐式转换丢失了 __unaligned 限定符">,
  InGroup<DiagGroup<"unaligned-qualifier-implicit-cast">>;

// Function effects
def warn_func_effect_violation : Warning<
  "%select{function|constructor|destructor|lambda|block|member initializer of constructor}0 "
  "with '%1' attribute "
  "must not %select{allocate or deallocate memory|throw or catch exceptions|"
  "have static local variables|use thread-local variables|access ObjC methods or properties}2"
  "\n" "警告：%select{函数|构造函数|析构函数|lambda|块|构造函数的成员初始化器}0 "
  "带 '%1' 特性 "
  "不得%select{分配或释放内存|抛出或捕获异常|"
  "具有静态局部变量|使用线程局部变量|访问 ObjC 方法或属性}2">,
  InGroup<FunctionEffects>, DefaultIgnore;
def note_func_effect_violation : Note<
  "%select{function|constructor|destructor|lambda|block|member initializer}0 "
  "cannot be inferred '%1' because it "
  "%select{allocates or deallocates memory|throws or catches exceptions|"
  "has a static local variable|uses a thread-local variable|"
  "accesses an ObjC method or property}2"
  "\n" "提示：%select{函数|构造函数|析构函数|lambda|块|成员初始化器}0 "
  "不能被推断为 '%1'，因为它 "
  "%select{分配或释放内存|抛出或捕获异常|"
  "具有静态局部变量|使用线程局部变量|"
  "访问 ObjC 方法或属性}2">;
def warn_func_effect_calls_func_without_effect : Warning<
  "%select{function|constructor|destructor|lambda|block|member initializer of constructor}0 "
  "with '%1' attribute "
  "must not call non-'%1' "
  "%select{function|constructor|destructor|lambda|block}2 "
  "'%3'"
  "\n" "警告：%select{函数|构造函数|析构函数|lambda|块|构造函数的成员初始化器}0 "
  "带 '%1' 特性 "
  "不得调用非 '%1' "
  "%select{函数|构造函数|析构函数|lambda|块}2 "
  "'%3'">,
  InGroup<FunctionEffects>, DefaultIgnore;
def note_func_effect_calls_func_without_effect : Note<
  "%select{function|constructor|destructor|lambda|block|member initializer}0 "
  "cannot be inferred '%1' because it calls non-'%1' "
  "%select{function|constructor|destructor|lambda|block}2 "
  "'%3'"
  "\n" "提示：%select{函数|构造函数|析构函数|lambda|块|成员初始化器}0 "
  "不能被推断为 '%1'，因为它调用了非 '%1' "
  "%select{函数|构造函数|析构函数|lambda|块}2 "
  "'%3'">;
def warn_func_effect_calls_expr_without_effect : Warning<
  "%select{function|constructor|destructor|lambda|block|member initializer of constructor}0 "
  "with '%1' attribute "
  "must not call non-'%1' expression"
  "\n" "警告：%select{函数|构造函数|析构函数|lambda|块|构造函数的成员初始化器}0 "
  "带 '%1' 特性 "
  "不得调用非 '%1' 表达式">,
  InGroup<FunctionEffects>, DefaultIgnore;
def note_func_effect_call_extern : Note<
  "declaration cannot be inferred '%0' because it has no definition in this translation unit"
  "\n" "提示：不能将声明推断为 '%0'，因为它在翻译单元中没有定义">;
def note_func_effect_call_disallows_inference : Note<
  "%select{function|constructor|destructor|lambda|block}0 "
  "does not permit inference of '%1' because it is declared '%2'"
  "\n" "提示：%select{函数|构造函数|析构函数|lambda|块}0 "
  "不允许推断为 '%1'，因为它被声明为 '%2'">;
def note_func_effect_call_indirect : Note<
  "%select{virtual method|function pointer}0 cannot be inferred '%1'"
  "\n" "提示：%select{虚方法|函数指针}0不能推断为 '%1'">;
def warn_perf_constraint_implies_noexcept : Warning<
  "%select{function|constructor|destructor|lambda|block}0 "
  "with '%1' attribute should be declared noexcept"
  "\n" "警告：%select{函数|构造函数|析构函数|lambda|块}0 "
  "带 '%1' 特性应声明为 noexcept">,
  InGroup<PerfConstraintImpliesNoexcept>, DefaultIgnore;

// FIXME: It would be nice if we could provide fuller template expansion notes.
def note_func_effect_from_template : Note<
  "in template expansion here"
  "\n" "提示：在此处进行模板展开">;
def note_func_effect_in_constructor : Note<
  "in%select{| implicit}0 constructor here"
  "\n" "提示：在%select{|隐式}0构造函数中">;
def note_in_evaluating_default_argument : Note<
  "in evaluating default argument here"
  "\n" "提示：在此处计算默认实参时">;

// spoofing nonblocking/nonallocating
def warn_invalid_add_func_effects : Warning<
  "attribute '%0' should not be added via type conversion"
  "\n" "警告：不应通过类型转换添加特性 '%0'">,
  InGroup<FunctionEffects>, DefaultIgnore;
def warn_conflicting_func_effect_override
    : Warning<"attribute '%0' on overriding function conflicts with base "
              "declaration"
  "\n" "警告：覆盖函数上的特性 '%0' 与基类 "
              "声明冲突">,
      InGroup<FunctionEffects>,
      DefaultIgnore;
def warn_conflicting_func_effects : Warning<
  "effects conflict when merging declarations; kept '%0', discarded '%1'"
  "\n" "警告：合并声明时效果冲突；保留 '%0'，丢弃 '%1'">,
  InGroup<FunctionEffects>, DefaultIgnore;
def err_func_with_effects_no_prototype : Error<
  "'%0' function must have a prototype"
  "\n" "错误：'%0' 函数必须具有原型">;
// These are more pedantic: in redeclarations and virtual method overrides,
// the effect attribute(s) should be restated.
def warn_mismatched_func_effect_override
    : Warning<"overriding function is missing '%0' attribute from base "
              "declaration"
  "\n" "警告：覆盖函数缺少基类 "
              "声明中的 '%0' 特性">,
      InGroup<FunctionEffectRedeclarations>,
      DefaultIgnore;
def warn_mismatched_func_effect_redeclaration
    : Warning<
          "redeclaration is missing '%0' attribute from previous declaration"
  "\n" "警告："
          "重新声明缺少先前声明中的 '%0' 特性">,
      InGroup<FunctionEffectRedeclarations>,
      DefaultIgnore;

} // end of sema category

