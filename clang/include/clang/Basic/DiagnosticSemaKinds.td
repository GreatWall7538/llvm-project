    "具有未知大小元素的数组}0" // array
  "，因为 %1 是%select{"
    "不完整的类型|"  // CountedByInvalidPointeeTypeKind::INCOMPLETE
    "无大小的类型|"     // CountedByInvalidPointeeTypeKind::SIZELESS
    "函数类型|"     // CountedByInvalidPointeeTypeKind::FUNCTION
    // CountedByInvalidPointeeTypeKind::FLEXIBLE_ARRAY_MEMBER
    "具有灵活数组成员的 struct 类型"
    "%select{|。这将在未来的编译器版本中成为错误}3"
    ""
  "}2">;
