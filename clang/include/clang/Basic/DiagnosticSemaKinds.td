  warn_format_conversion_argument_type_mismatch.Summary>,
  InGroup<FormatPedantic>;
def warn_format_conversion_argument_type_mismatch_signedness: Warning<
      "format specifies type %0 but the argument has %select{type|underlying "
      "type}2 %1, which differs in signedness"
      "\n" "警告：格式指定类型 %0，但实参具有%select{类型|底层 "
      "类型}2 %1，其符号性不同" >
    , InGroup<FormatSignedness>, DefaultIgnore;
def warn_format_conversion_argument_type_mismatch_confusion : Warning<
  warn_format_conversion_argument_type_mismatch.Summary>,
  InGroup<FormatTypeConfusion>, DefaultIgnore;
def warn_format_argument_needs_cast : Warning<
  "%select{values of type|enum values with underlying type}2 '%0' should not "
  "be used as format arguments; add an explicit cast to %1 instead"
  "\n" "警告：%select{类型的值|具有底层类型的枚举值}2 '%0' 不应 "
  "被用作格式实参；请改为显式转换为 %1">,
  InGroup<Format>;
def warn_format_argument_needs_cast_pedantic : Warning<
  warn_format_argument_needs_cast.Summary>,
  InGroup<FormatPedantic>, DefaultIgnore;
def warn_printf_positional_arg_exceeds_data_args : Warning <
  "data argument position '%0' exceeds the number of data arguments (%1)"
  "\n" "警告：数据实参位置 '%0' 超过数据实参数量（%1）">,
  InGroup<Format>;
def warn_format_zero_positional_specifier : Warning<
  "position arguments in format strings start counting at 1 (not 0)"
  "\n" "警告：格式字符串中的位置实参从 1（不是 0）开始计数">,
  InGroup<Format>;
def warn_format_invalid_positional_specifier : Warning<
  "invalid position specified for %select{field width|field precision}0"
  "\n" "警告：为%select{字段宽度|字段精度}0指定的位置无效">,
  InGroup<Format>;
def warn_format_mix_positional_nonpositional_args : Warning<
  "cannot mix positional and non-positional arguments in format string"
  "\n" "警告：不能在格式字符串中混用位置实参和非位置实参">,
  InGroup<Format>;
def warn_static_array_too_small : Warning<
  "array argument is too small; %select{contains %0 elements|is of size %0}2,"
  " callee requires at least %1"
  "\n" "警告：数组实参太小；%select{包含 %0 个元素|大小为 %0}2，"
  " 被调用方至少需要 %1">,
  InGroup<ArrayBounds>;
def note_callee_static_array : Note<
  "callee declares array parameter as static here"
  "\n" "提示：被调用方在此处将数组形参声明为 static">;
def warn_empty_format_string : Warning<
  "format string is empty"
  "\n" "警告：格式字符串为空">, InGroup<FormatZeroLength>;
def warn_format_string_is_wide_literal : Warning<
  "format string should not be a wide string"
  "\n" "警告：格式字符串不应该是宽字符串">, InGroup<Format>;
def warn_printf_format_string_contains_null_char : Warning<
  "format string contains '\\0' within the string body"
  "\n" "警告：格式字符串在字符串体内包含 '\\0'">, InGroup<Format>;
def warn_printf_format_string_not_null_terminated : Warning<
  "format string is not null-terminated"
  "\n" "警告：格式字符串未以 null 结尾">, InGroup<Format>;
def warn_printf_asterisk_missing_arg : Warning<
  "'%select{*|.*}0' specified field %select{width|precision}0 is missing a matching 'int' argument"
  "\n" "警告：'%select{*|.*}0' 指定的字段%select{宽度|精度}0缺少匹配的 'int' 实参">,
  InGroup<Format>;
def warn_printf_asterisk_wrong_type : Warning<
  "field %select{width|precision}0 should have type %1, but argument has type %2"
  "\n" "警告：字段%select{宽度|精度}0应具有类型 %1，但实参具有类型 %2">,
  InGroup<Format>;
def err_printf_asterisk_wrong_type : Error<
  "field %select{width|precision}0 should have type %1, but argument has type %2"
  "\n" "错误：字段%select{宽度|精度}0应具有类型 %1，但实参具有类型 %2">;
def warn_printf_nonsensical_optional_amount: Warning<
  "%select{field width|precision}0 used with '%1' conversion specifier, resulting in undefined behavior"
  "\n" "警告：%select{字段宽度|精度}0与 '%1' 转换说明符一起使用，导致未定义行为">,
  InGroup<Format>;
def warn_printf_nonsensical_flag: Warning<
  "flag '%0' results in undefined behavior with '%1' conversion specifier"
  "\n" "警告：标志 '%0' 与 '%1' 转换说明符一起使用会导致未定义行为">,
  InGroup<Format>;
def warn_format_nonsensical_length: Warning<
  "length modifier '%0' results in undefined behavior or no effect with '%1' conversion specifier"
  "\n" "警告：长度修饰符 '%0' 与 '%1' 转换说明符一起使用会导致未定义行为或没有效果">,
  InGroup<Format>;
def warn_format_non_standard_positional_arg: Warning<
  "positional arguments are not supported by ISO C"
  "\n" "警告：ISO C 不支持位置实参">, InGroup<FormatNonStandard>, DefaultIgnore;
def warn_format_non_standard: Warning<
  "'%0' %select{length modifier|conversion specifier}1 is not supported by ISO C"
  "\n" "警告：'%0' %select{长度修饰符|转换说明符}1不受 ISO C 支持">,
  InGroup<FormatNonStandard>, DefaultIgnore;
def warn_format_non_standard_conversion_spec: Warning<
  "using length modifier '%0' with conversion specifier '%1' is not supported by ISO C"
  "\n" "警告：ISO C 不支持将长度修饰符 '%0' 与转换说明符 '%1' 一起使用">,
  InGroup<FormatNonStandard>, DefaultIgnore;
def err_invalid_mask_type_size : Error<
  "mask type size must be between 1-byte and 8-bytes"
  "\n" "错误：掩码类型大小必须介于 1 字节和 8 字节之间">;
def warn_format_invalid_annotation : Warning<
  "using '%0' format specifier annotation outside of os_log()/os_trace()"
  "\n" "警告：在 os_log()/os_trace() 之外使用 '%0' 格式说明符注释">,
  InGroup<Format>;
def warn_format_P_no_precision : Warning<
  "using '%%P' format specifier without precision"
  "\n" "警告：使用不带精度的 '%%P' 格式说明符">,
  InGroup<Format>;
def warn_format_P_with_objc_pointer : Warning<
  "using '%%P' format specifier with an Objective-C pointer results in dumping runtime object structure, not object value"
  "\n" "警告：将 '%%P' 格式说明符与 Objective-C 指针一起使用会转储运行时对象结构，而不是对象值">,
  InGroup<Format>;
def warn_printf_ignored_flag: Warning<
  "flag '%0' is ignored when flag '%1' is present"
  "\n" "警告：当存在标志 '%1' 时，标志 '%0' 被忽略">,
  InGroup<Format>;
def warn_printf_empty_objc_flag: Warning<
  "missing object format flag"
  "\n" "警告：缺少对象格式标志">,
  InGroup<Format>;
def warn_printf_ObjCflags_without_ObjCConversion: Warning<
  "object format flags cannot be used with '%0' conversion specifier"
  "\n" "警告：对象格式标志不能与 '%0' 转换说明符一起使用">,
  InGroup<Format>;
def warn_printf_invalid_objc_flag: Warning<
    "'%0' is not a valid object format flag"
    "\n" "警告：'%0' 不是有效的对象格式标志">,
    InGroup<Format>;
def warn_printf_narg_not_supported : Warning<
    "'%%n' specifier not supported on this platform"
    "\n" "警告：此平台不支持 '%%n' 说明符">,
    InGroup<Format>;
def warn_scanf_scanlist_incomplete : Warning<
  "no closing ']' for '%%[' in scanf format string"
  "\n" "警告：scanf 格式字符串中 '%%[' 没有右 ']'">,
  InGroup<Format>;
def warn_format_bool_as_character : Warning<
  "using '%0' format specifier, but argument has boolean value"
  "\n" "警告：使用 '%0' 格式说明符，但实参具有布尔值">,
  InGroup<Format>;
def note_format_string_defined : Note<"format string is defined here"
  "\n" "提示：格式字符串在此定义">;
def note_format_fix_specifier : Note<"did you mean to use '%0'?"
  "\n" "提示：您是指使用 '%0' 吗？">;
def note_printf_c_str: Note<"did you mean to call the %0 method?"
  "\n" "提示：您是指调用 %0 方法吗？">;
def note_format_security_fixit: Note<
  "treat the string as an argument to avoid this"
  "\n" "提示：将字符串作为实参对待以避免此问题">;
def warn_format_string_type_incompatible : Warning<
  "passing '%0' format string where '%1' format string is expected"
  "\n" "警告：传递 '%0' 格式字符串，但期望 '%1' 格式字符串">,
  InGroup<Format>;
def warn_format_cmp_role_mismatch : Warning<
  "format argument is %select{a value|an indirect field width|an indirect "
  "precision|an auxiliary value}0, but it should be %select{a value|an indirect "
  "field width|an indirect precision|an auxiliary value}1"
  "\n" "警告：格式实参是%select{值|间接字段宽度|间接 "
  "精度|辅助值}0，但应为%select{值|间接 "
  "字段宽度|间接精度|辅助值}1">, InGroup<Format>;
def warn_format_cmp_modifierfor_mismatch : Warning<
  "format argument modifies specifier at position %0, but it should modify "
  "specifier at position %1"
  "\n" "警告：格式实参修改位置 %0 处的说明符，但应修改 "
  "位置 %1 处的说明符">, InGroup<Format>;
def warn_format_cmp_sensitivity_mismatch : Warning<
  "argument sensitivity is %select{unspecified|private|public|sensitive}0, but "
  "it should be %select{unspecified|private|public|sensitive}1"
  "\n" "警告：实参敏感性是%select{未指定|私有|公开|敏感}0，但 "
  "应为%select{未指定|私有|公开|敏感}1">, InGroup<Format>;
def warn_format_cmp_specifier_mismatch : Warning<
  "format specifier '%0' is incompatible with '%1'"
  "\n" "警告：格式说明符 '%0' 与 '%1' 不兼容">, InGroup<Format>;
def warn_format_cmp_specifier_sign_mismatch
    : Warning<"signedness of format specifier '%0' is incompatible with '%1'"
      "\n" "警告：格式说明符 '%0' 的符号性与 '%1' 不兼容">,
      InGroup<FormatSignedness>,
      DefaultIgnore;
