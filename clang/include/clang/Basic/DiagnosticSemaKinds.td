  "'%select{|short|long|long long}0 %1' is invalid"
  "\n" "错误：'%select{|short|long|long long}0 %1' 无效">;
def err_invalid_complex_spec : Error<"'_Complex %0' is invalid"
  "\n" "错误：'_Complex %0' 无效">;

def ext_auto_type_specifier : ExtWarn<
