  "\n" "错误：来自没有定义的类 %1 的 %0 的行外定义">;
def err_member_decl_does_not_match : Error<
  "out-of-line %select{declaration|definition}2 of %0 "
  "does not match any declaration in %1"
  "\n" "错误：%0 的行外%select{声明|定义}2"
