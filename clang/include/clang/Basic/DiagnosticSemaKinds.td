  "incompatible constant for this __builtin_neon function"
  "\n" "错误：与此 __builtin_neon 函数不兼容的常量">;
def err_argument_invalid_range : Error<
  "argument value %0 is outside the valid range [%1, %2]"
  "\n" "错误：实参值 %0 在有效范围 [%1, %2] 之外">;
