def warn_empty_parens_are_function_decl : Warning<
  "empty parentheses interpreted as a function declaration"
  "\n" "警告：空括号被解释为函数声明">,
  InGroup<VexingParse>;
def warn_parens_disambiguated_as_function_declaration : Warning<
