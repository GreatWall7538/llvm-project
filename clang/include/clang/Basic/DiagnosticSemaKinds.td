  "\n" "警告：不能在字段声明上指定 __weak 特性">,
  InGroup<IgnoredAttributes>;
def warn_gc_attribute_weak_on_local : Warning<
  "Objective-C GC does not allow weak variables on the stack"
  "\n" "警告：Objective-C GC 不允许栈上的弱变量">,
  InGroup<IgnoredAttributes>;
def warn_nsobject_attribute : Warning<
  "'NSObject' attribute may be put on a typedef only; attribute is ignored"
  "\n" "警告：'NSObject' 特性只能放在 typedef 上；忽略该特性">,
  InGroup<NSobjectAttribute>;
def warn_independentclass_attribute : Warning<
  "'objc_independent_class' attribute may be put on a typedef only; "
  "attribute is ignored"
  "\n" "警告：'objc_independent_class' 特性只能放在 typedef 上；"
  "忽略该特性">,
  InGroup<IndependentClassAttribute>;
def warn_ptr_independentclass_attribute : Warning<
  "'objc_independent_class' attribute may be put on Objective-C object "
  "pointer type only; attribute is ignored"
  "\n" "警告：'objc_independent_class' 特性只能放在 Objective-C 对象"
  "指针类型上；忽略该特性">,
  InGroup<IndependentClassAttribute>;
def warn_attribute_weak_on_local : Warning<
  "__weak attribute cannot be specified on an automatic variable when ARC "
  "is not enabled"
  "\n" "警告：未启用 ARC 时，不能在自动变量上指定 __weak 特性">,
  InGroup<IgnoredAttributes>;
def warn_weak_identifier_undeclared : Warning<
  "weak identifier %0 never declared"
  "\n" "警告：弱标识符 %0 从未声明">;
def warn_attribute_cmse_entry_static : Warning<
  "'cmse_nonsecure_entry' cannot be applied to functions with internal linkage"
  "\n" "警告：'cmse_nonsecure_entry' 不能应用于具有内部链接的函数">,
  InGroup<IgnoredAttributes>;
def warn_cmse_nonsecure_union : Warning<
  "passing union across security boundary via %select{parameter %1|return value}0 "
  "may leak information"
  "\n" "警告：通过%select{参数 %1|返回值}0"
  "跨安全边界传递联合可能泄露信息">,
  InGroup<DiagGroup<"cmse-union-leak">>;
def err_attribute_weak_static : Error<
  "weak declaration cannot have internal linkage"
  "\n" "错误：弱声明不能具有内部链接">;
def err_attribute_selectany_non_extern_data : Error<
  "'selectany' can only be applied to data items with external linkage"
  "\n" "错误：'selectany' 只能应用于具有外部链接的数据项">;
def warn_attribute_hybrid_patchable_non_extern : Warning<
  "'hybrid_patchable' is ignored on functions without external linkage"
  "\n" "警告：'hybrid_patchable' 在没有外部链接的函数上被忽略">,
  InGroup<IgnoredAttributes>;
def err_declspec_thread_on_thread_variable : Error<
  "'__declspec(thread)' applied to variable that already has a "
  "thread-local storage specifier"
  "\n" "错误：'__declspec(thread)' 应用于已经具有线程局部存储说明符的变量">;
def err_attribute_dll_not_extern : Error<
  "%q0 must have external linkage when declared %q1"
  "\n" "错误：%q0 在声明为 %q1 时必须具有外部链接">;
def err_attribute_dll_thread_local : Error<
  "%q0 cannot be thread local when declared %q1"
  "\n" "错误：%q0 在声明为 %q1 时不能是线程局部的">;
def err_attribute_dll_lambda : Error<
  "lambda cannot be declared %0"
  "\n" "错误：lambda 不能声明为 %0">;
def warn_attribute_invalid_on_definition : Warning<
  "'%0' attribute cannot be specified on a definition"
  "\n" "警告：不能在定义上指定 '%0' 特性">,
  InGroup<IgnoredAttributes>;
def err_attribute_dll_redeclaration : Error<
  "redeclaration of %q0 cannot add %q1 attribute"
  "\n" "错误：%q0 的重新声明不能添加 %q1 特性">;
def warn_attribute_dll_redeclaration : Warning<
  "redeclaration of %q0 should not add %q1 attribute"
  "\n" "警告：%q0 的重新声明不应添加 %q1 特性">,
  InGroup<DiagGroup<"dll-attribute-on-redeclaration">>;
def err_attribute_dllimport_function_definition : Error<
  "dllimport cannot be applied to non-inline function definition"
  "\n" "错误：dllimport 不能应用于非 inline 函数定义">;
def err_attribute_dllimport_function_specialization_definition : Error<
  "cannot define non-inline dllimport template specialization"
  "\n" "错误：不能定义非 inline 的 dllimport 模板特化">;
def err_attribute_dll_deleted : Error<
  "attribute %q0 cannot be applied to a deleted function"
  "\n" "错误：特性 %q0 不能应用于删除的函数">;
def err_attribute_dllimport_data_definition : Error<
  "definition of dllimport data"
  "\n" "错误：dllimport 数据的定义">;
def err_attribute_dllimport_static_field_definition : Error<
  "definition of dllimport static field not allowed"
  "\n" "错误：不允许定义 dllimport 静态字段">;
def warn_attribute_dllimport_static_field_definition : Warning<
  "definition of dllimport static field"
  "\n" "警告：dllimport 静态字段的定义">,
  InGroup<DiagGroup<"dllimport-static-field-def">>;
def warn_attribute_dllexport_explicit_instantiation_decl : Warning<
  "explicit instantiation declaration should not be 'dllexport'"
  "\n" "警告：显式实例化声明不应是 'dllexport'">,
  InGroup<DllexportExplicitInstantiationDecl>;
def warn_attr_dllexport_explicit_inst_def : Warning<
  "'dllexport' attribute ignored on explicit instantiation definition"
  "\n" "警告：显式实例化定义上的 'dllexport' 特性被忽略">,
  InGroup<DllexportExplicitInstantiation>;
def warn_attr_dllexport_explicit_inst_def_mismatch : Warning<
  "'dllexport' attribute ignored on explicit instantiation definition"
  "\n" "警告：显式实例化定义上的 'dllexport' 特性被忽略">,
  InGroup<IgnoredAttributes>;
def note_prev_decl_missing_dllexport : Note<
  "'dllexport' attribute is missing on previous declaration"
  "\n" "提示：先前的声明缺少 'dllexport' 特性">;
def warn_dllexport_on_decl_ignored : Warning<
  "explicit instantiation definition is not exported without 'dllexport'"
  "\n" "警告：没有 'dllexport' 时，显式实例化定义不会被导出">,
  InGroup<IgnoredAttributes>;
def note_dllexport_on_decl : Note<
  "'dllexport' attribute on the declaration is ignored"
  "\n" "提示：声明上的 'dllexport' 特性被忽略">;

def warn_dllexport_inherited_ctor_unsupported : Warning<
  "exporting inherited constructor is not yet supported; "
  "'dllexport' ignored on inherited constructor with "
  "%select{variadic arguments|callee-cleanup parameters}0"
  "\n" "警告：尚不支持导出继承的构造函数；"
  "带%select{可变参数实参|被调用方清理参数}0的继承构造函数上 'dllexport' 被忽略">,
  InGroup<IgnoredAttributes>;
def warn_attribute_exclude_from_explicit_instantiation_local_class : Warning<
  "%0 attribute ignored on local class%select{| member}1"
  "\n" "警告：本地类%select{|成员}1上的 %0 特性被忽略">,
  InGroup<IgnoredAttributes>;
def warn_invalid_initializer_from_system_header : Warning<
  "invalid constructor from class in system header, should not be explicit"
  "\n" "警告：系统头文件中类的构造函数无效，不应为 explicit">,
  InGroup<DiagGroup<"invalid-initializer-from-system-header">>;
def note_used_in_initialization_here : Note<"used in initialization here"
  "\n" "提示：在此用于初始化">;
def err_attribute_dll_member_of_dll_class : Error<
  "attribute %q0 cannot be applied to member of %q1 class"
  "\n" "错误：特性 %q0 不能应用于 %q1 类的成员">;
def warn_attribute_dll_instantiated_base_class : Warning<
  "propagating dll attribute to %select{already instantiated|explicitly specialized}0 "
  "base class template without dll attribute is not supported"
  "\n" "警告：不支持将 dll 特性传播到没有 dll 特性的%select{已实例化的|已显式特化的}0基类模板">,
  InGroup<DiagGroup<"unsupported-dll-base-class-template">>, DefaultIgnore;
def err_attribute_dll_ambiguous_default_ctor : Error<
  "'__declspec(dllexport)' cannot be applied to more than one default constructor in %0"
  "\n" "错误：'__declspec(dllexport)' 不能应用于 %0 中的多个默认构造函数">;
def err_attribute_weakref_not_static : Error<
  "weakref declaration must have internal linkage"
  "\n" "错误：weakref 声明必须具有内部链接">;
def err_attribute_weakref_not_global_context : Error<
  "weakref declaration of %0 must be in a global context"
  "\n" "错误：%0 的 weakref 声明必须在全局上下文中">;
def err_attribute_weakref_without_alias : Error<
  "weakref declaration of %0 must also have an alias attribute"
  "\n" "错误：%0 的 weakref 声明还必须具有 alias 特性">;
def err_alias_not_supported_on_darwin : Error <
  "aliases are not supported on darwin"
  "\n" "错误：darwin 上不支持别名">;
def warn_attribute_non_character_array : Warning<
  "%0%select{ attribute|}1 only applies to fields or variables of character "
  "array type; type is %2"
  "\n" "警告：%0%select{ 特性|}1仅适用于字符"
  "数组类型的字段或变量；类型是 %2">, InGroup<IgnoredAttributes>;
def warn_attribute_wrong_decl_type_str : Warning<
  "%0%select{ attribute|}1 only applies to %2"
  "\n" "警告：%0%select{ 特性|}1仅适用于 %2">, InGroup<IgnoredAttributes>;
def err_attribute_wrong_decl_type_str : Error<
  warn_attribute_wrong_decl_type_str.Summary>;
def warn_attribute_wrong_decl_type : Warning<
  "%0%select{ attribute|}1 only applies to %select{"
  "functions"
  "|unions"
  "|variables and functions"
  "|functions and methods"
  "|functions, methods and blocks"
  "|functions, methods, and parameters"
  "|variables"
  "|variables and fields"
  "|variables, data members and tag types"
  "|types and namespaces"
  "|variables, functions and classes"
  "|kernel functions"
  "|non-K&R-style functions"
  "|for loop statements"
  "|virtual functions"
  "|parameters and implicit object parameters"
  "|non-member functions"
  "|functions, classes, or enumerations"
  "|classes"
  "|typedefs}2"
  "\n" "警告：%0%select{ 特性|}1仅适用于%select{"
  "函数"
  "|联合"
  "|变量和函数"
  "|函数和方法"
  "|函数、方法和块"
  "|函数、方法和参数"
  "|变量"
  "|变量和字段"
  "|变量、数据成员和标签类型"
  "|类型和命名空间"
  "|变量、函数和类"
  "|内核函数"
  "|非 K&R 风格函数"
  "|for 循环语句"
  "|虚拟函数"
  "|参数和隐式对象参数"
  "|非成员函数"
  "|函数、类或枚举"
  "|类"
  "|typedef}2">,
  InGroup<IgnoredAttributes>;
def err_attribute_wrong_decl_type : Error<warn_attribute_wrong_decl_type.Summary>;
def warn_type_attribute_wrong_type : Warning<
  "'%0' only applies to %select{function|pointer|"
  "Objective-C object or block pointer}1 types; type here is %2"
  "\n" "警告：'%0' 仅适用于%select{函数|指针|"
  "Objective-C 对象或块指针}1类型；此处的类型是 %2">,
  InGroup<IgnoredAttributes>;
def warn_attribute_on_void_param: Warning<
  "attribute %0 cannot be applied to a 'void' parameter"
  "\n" "警告：%0 特性不能应用于 'void' 参数">,
  InGroup<IgnoredAttributes>;
def err_type_attribute_wrong_type : Error<
  warn_type_attribute_wrong_type.Summary>;
def warn_incomplete_encoded_type : Warning<
  "encoding of %0 type is incomplete because %1 component has unknown encoding"
  "\n" "警告：%0 类型的编码不完整，因为 %1 组件具有未知的编码">,
  InGroup<DiagGroup<"encode-type">>;
def warn_gnu_inline_attribute_requires_inline : Warning<
  "'gnu_inline' attribute requires function to be marked 'inline',"
  " attribute ignored"
  "\n" "警告：'gnu_inline' 特性要求函数被标记为 'inline'，"
  "忽略该特性">,
  InGroup<IgnoredAttributes>;
def warn_gnu_inline_cplusplus_without_extern : Warning<
  "'gnu_inline' attribute without 'extern' in C++ treated as externally"
  " available, this changed in Clang 10"
  "\n" "警告：在 C++ 中不带 'extern' 的 'gnu_inline' 特性被当作外部可用的，这在 Clang 10 中发生了变化">,
  InGroup<DiagGroup<"gnu-inline-cpp-without-extern">>;
def err_attribute_vecreturn_only_vector_member : Error<
  "the vecreturn attribute can only be used on a class or structure with one member, which must be a vector"
  "\n" "错误：vecreturn 特性只能用于具有一个成员的类或结构，该成员必须是向量">;
def err_attribute_vecreturn_only_pod_record : Error<
  "the vecreturn attribute can only be used on a POD (plain old data) class or structure (i.e. no virtual functions)"
  "\n" "错误：vecreturn 特性只能用于 POD（普通旧数据）类或结构（即没有虚拟函数）">;
def err_attribute_pointer_field_protection_experimental
    : Error<"this attribute is experimental and must be explicitly enabled "
            "with flag -fexperimental-allow-pointer-field-protection-attr"
            "\n" "错误：此特性是实验性的，必须通过标志 -fexperimental-allow-pointer-field-protection-attr 显式启用">;
def err_sme_attr_mismatch : Error<
  "function declared %0 was previously declared %1, which has different SME function attributes"
  "\n" "错误：声明为 %0 的函数先前被声明为 %1，二者具有不同的 SME 函数特性">;
def err_sme_call_in_non_sme_target : Error<
  "call to a streaming function requires 'sme'"
  "\n" "错误：调用流式函数需要 'sme'">;
def err_sme_za_call_no_za_state : Error<
  "call to a shared ZA function requires the caller to have ZA state"
  "\n" "错误：调用共享 ZA 函数要求调用者具有 ZA 状态">;
def err_sme_zt0_call_no_zt0_state : Error<
  "call to a shared ZT0 function requires the caller to have ZT0 state"
  "\n" "错误：调用共享 ZT0 函数要求调用者具有 ZT0 状态">;
def err_sme_unimplemented_za_save_restore : Error<
  "call to a function that shares state other than 'za' from a "
  "function that has live 'za' state requires a spill/fill of ZA, which is not yet "
  "implemented"
  "\n" "错误：从具有活动 'za' 状态的函数调用共享除 'za' 之外状态的函数需要 ZA 的溢出/填充，该功能尚未"
  "实现">;
def err_sme_unsupported_agnostic_new : Error<
  "__arm_agnostic(\"sme_za_state\") is not supported together with "
  "__arm_new(\"za\") or __arm_new(\"zt0\")"
  "\n" "错误：__arm_agnostic(\"sme_za_state\") 不能与 "
  "__arm_new(\"za\") 或 __arm_new(\"zt0\") 一起使用">;
def note_sme_use_preserves_za : Note<
  "add '__arm_preserves(\"za\")' to the callee if it preserves ZA"
  "\n" "提示：如果被调用者保留 ZA，请向被调用者添加 '__arm_preserves(\"za\")'">;
def err_sme_definition_using_sm_in_non_sme_target : Error<
  "function executed in streaming-SVE mode requires 'sme'"
  "\n" "错误：在流式 SVE 模式下执行的函数需要 'sme'">;
def err_sme_definition_using_za_in_non_sme_target : Error<
  "function using ZA state requires 'sme'"
  "\n" "错误：使用 ZA 状态的函数需要 'sme'">;
def err_sme_definition_using_zt0_in_non_sme2_target : Error<
  "function using ZT0 state requires 'sme2'"
  "\n" "错误：使用 ZT0 状态的函数需要 'sme2'">;
def err_sme_openmp_captured_region : Error<
  "OpenMP captured regions are not yet supported in "
  "%select{streaming functions|functions with ZA state|functions with ZT0 state}0"
  "\n" "错误：尚不支持%select{流式函数|具有 ZA 状态的函数|具有 ZT0 状态的函数}0中的"
  "OpenMP 捕获区域">;
def warn_sme_streaming_pass_return_vl_to_non_streaming : Warning<
  "%select{returning|passing}0 a VL-dependent argument %select{from|to}0 a function with a different"
  " streaming-mode is undefined behaviour when the streaming and non-streaming vector lengths are different at runtime"
  "\n" "警告：%select{返回|传递}0 VL 相关实参%select{从|到}0具有不同"
  "流式模式的函数，当运行时流式和非流式向量长度不同时是未定义行为">,
  InGroup<AArch64SMEAttributes>, DefaultIgnore;
def warn_sme_locally_streaming_has_vl_args_returns : Warning<
  "%select{returning|passing}0 a VL-dependent argument %select{from|to}0 a locally streaming function is undefined"
  " behaviour when the streaming and non-streaming vector lengths are different at runtime"
  "\n" "警告：%select{返回|传递}0 VL 相关实参%select{从|到}0本地流式函数，当运行时流式和非流式向量长度不同时是未定义"
  "行为">,
  InGroup<AArch64SMEAttributes>, DefaultIgnore;
def warn_sme_streaming_compatible_vl_mismatch : Warning<
  "%select{returning|passing}0 a VL-dependent argument %select{from|to}0 a %select{non-streaming|streaming}1"
  " function is undefined behaviour when the streaming-compatible caller is%select{| not}1 in streaming"
  " mode, because the streaming vector length (%2 bit) and non-streaming vector length (%3 bit) differ"
  "\n" "警告：%select{返回|传递}0 VL 相关实参%select{从|到}0%select{非流式|流式}1"
  "函数，当流式兼容的调用者%select{|不}1处于流式"
  "模式时是未定义行为，因为流式向量长度（%2 位）和非流式向量长度（%3 位）不同">,
  InGroup<AArch64SMEAttributes>, DefaultIgnore;
def err_sme_streaming_transition_vl_mismatch : Error<
  "%select{returning|passing}0 a VL-dependent argument %select{from|to}0 a function with a different"
  " streaming-mode is undefined behaviour because the streaming vector length (%1 bit) and non-streaming vector length (%2 bit) differ"
  "\n" "错误：%select{返回|传递}0 VL 相关实参%select{从|到}0具有不同"
  "流式模式的函数，因为流式向量长度（%1 位）和非流式向量长度（%2 位）不同，所以是未定义行为">;
def err_conflicting_attributes_arm_agnostic : Error<
  "__arm_agnostic(\"sme_za_state\") cannot share ZA state with its caller"
  "\n" "错误：__arm_agnostic(\"sme_za_state\") 不能与其调用者共享 ZA 状态">;
def err_conflicting_attributes_arm_state : Error<
  "conflicting attributes for state '%0'"
  "\n" "错误：状态 '%0' 的特性冲突">;
def err_unknown_arm_state : Error<
  "unknown state '%0'"
  "\n" "错误：未知的状态 '%0'">;
def err_missing_arm_state : Error<
  "missing state for %0"
  "\n" "错误：%0 缺少状态">;
def err_cconv_change : Error<
  "function declared '%0' here was previously declared "
  "%select{'%2'|without calling convention}1"
  "\n" "错误：此处声明为 '%0' 的函数先前被声明为 "
  "%select{'%2'|无调用约定}1">;
def warn_cconv_unsupported : Warning<
  "%0 calling convention is not supported %select{"
  // Use CallingConventionIgnoredReason Enum to specify these.
  "for this target"
  "|on variadic function"
  "|on constructor/destructor"
  "|on builtin function"
  "}1"
  "\n" "警告：不支持 %0 调用约定%select{"
  // Use CallingConventionIgnoredReason Enum to specify these.
  "对此目标"
  "|在可变参数函数上"
  "|在构造函数/析构函数上"
  "|在内建函数上"
  "}1">,
  InGroup<IgnoredAttributes>;
def error_cconv_unsupported : Error<warn_cconv_unsupported.Summary>;
def err_cconv_knr : Error<
  "function with no prototype cannot use the %0 calling convention"
  "\n" "错误：没有原型的函数不能使用 %0 调用约定">;
def warn_cconv_knr : Warning<
