  "\n" "提示：期望 map 子句上的 'this' 下标表达式为 'this[0]'">;
def err_omp_invalid_map_this_expr : Error <
  "invalid 'this' expression on 'map' clause"
  "\n" "错误：'map' 子句上的无效 'this' 表达式">;
