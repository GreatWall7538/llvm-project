def warn_unused_result : Warning<
  "ignoring return value of function declared with %0 attribute%select{|: %2}1" "\n" "警告：忽略了使用 %0 属性声明的函数的返回值%select{|：%2}1">,
  InGroup<UnusedResult>;
def warn_unused_result_typedef_unsupported_spelling : Warning<
  "'[[%select{nodiscard|gnu::warn_unused_result}0]]' attribute ignored when "
  "applied to a typedef; consider using '__attribute__((warn_unused_result))' "
  "or '[[clang::warn_unused_result]]' instead" "\n" "警告：应用于 typedef 时忽略了 '[[%select{nodiscard|gnu::warn_unused_result}0]]' 属性；请考虑改用 '__attribute__((warn_unused_result))' 或 '[[clang::warn_unused_result]]'">, InGroup<IgnoredAttributes>;
def warn_unused_volatile : Warning<
  "expression result unused; assign into a variable to force a volatile load" "\n" "警告：表达式的结果未被使用；请赋值给变量以强制进行 volatile 读取">,
  InGroup<DiagGroup<"unused-volatile-lvalue">>;

def ext_cxx14_attr : Extension<
