//===----------------------------------------------------------------------===//
// Semantic Analysis
//===----------------------------------------------------------------------===//

let Component = "Sema" in {
let CategoryName = "Semantic Issue" in {
// C++11 compatibility with C++98.
defm nonclass_type_friend : CXX11Compat<"non-class friend type %0 is"
  "\n" "警告：非类 friend 类型 %0 是">;
defm static_data_member_in_union : CXX11Compat<"static data member %0 in union is"
  "\n" "警告：联合中的静态数据成员 %0 是">;
defm templ_default_in_function_templ : CXX11Compat<
  "default template arguments for a function template are"
  "\n" "警告：函数模板的默认模板实参是">;
defm template_arg_extra_parens : CXX11Compat<
  "parentheses around address non-type template argument are"
  "\n" "警告：地址非类型模板实参周围的括号是">;
defm typename_outside_of_template : CXX11Compat<"'typename' outside of a template is"
  "\n" "警告：模板外的 'typename' 是">;

// C++14 compatibility with C++11 and earlier.
defm constexpr_type_definition : CXX14Compat<
  "type definition in a constexpr %select{function|constructor}0 is"
  "\n" "警告：constexpr %select{函数|构造函数}0中的类型定义是">;
defm constexpr_local_var : CXX14Compat<
  "variable declaration in a constexpr %select{function|constructor}0 is"
  "\n" "警告：constexpr %select{函数|构造函数}0中的变量声明是">;
defm constexpr_body_multiple_return : CXX14Compat<
  "multiple return statements in constexpr function is"
  "\n" "警告：constexpr 函数中的多个 return 语句是">;
defm variable_template : CXX14Compat<"variable templates are"
  "\n" "警告：变量模板是">;

// C++17 compatibility with C++14 and earlier.
defm decomp_decl : CXX17Compat<"structured binding declarations are"
  "\n" "警告：结构化绑定声明是">;
defm inline_variable : CXX17Compat<"inline variables are"
  "\n" "警告：内联变量是">;

// C++20 compatibility with C++17 and earlier.
defm decomp_decl_spec
    : CXX20Compat<"structured binding declaration declared '%0' is"
      "\n" "警告：声明为 '%0' 的结构化绑定声明是">;
defm constexpr_local_var_no_init : CXX20Compat<
  "uninitialized variable in a constexpr %select{function|constructor}0 is"
  "\n" "警告：constexpr %select{函数|构造函数}0中的未初始化变量是">;
defm constexpr_function_try_block : CXX20Compat<
  "function try block in constexpr %select{function|constructor}0 is"
  "\n" "警告：constexpr %select{函数|构造函数}0中的函数 try 块是">;
defm constexpr_union_ctor_no_init : CXX20Compat<
  "constexpr union constructor that does not initialize any member is"
  "\n" "警告：不初始化任何成员的 constexpr 联合构造函数是">;
defm constexpr_ctor_missing_init : CXX20Compat<
  "constexpr constructor that does not initialize all members is"
  "\n" "警告：未初始化所有成员的 constexpr 构造函数是">;
defm adl_only_template_id : CXX20Compat<
  "use of function template name with no prior declaration in function call "
  "with explicit template arguments is"
  "\n" "警告：在带有显式模板实参的函数调用中使用没有先前声明的函数模板名是">;
defm ctad_for_alias_templates
    : CXX20Compat<"class template argument deduction for alias templates is"
      "\n" "警告：别名模板的类模板实参推导是">;
defm implicit_typename
    : CXX20Compat<"missing 'typename' prior to dependent type name %0 is"
      "\n" "警告：依赖类型名 %0 之前缺少 'typename' 是">;

defm auto_param : CXX20Compat<"'auto' parameters are"
  "\n" "警告：'auto' 参数是">;

// C++23 compatibility with C++20 and earlier.
defm constexpr_static_var : CXX23Compat<
  "definition of a %select{static|thread_local}1 variable "
  "in a constexpr %select{function|constructor}0 "
  "is"
  "\n" "警告：constexpr %select{函数|构造函数}0中"
  "%select{static|thread_local}1变量的定义是">;

// C++26 compatibility with C++23 and earlier.
defm decomp_decl_cond : CXX26Compat<"structured binding declaration in a condition is"
  "\n" "警告：条件中的结构化绑定声明是">;

// Compatibility warnings duplicated across multiple language versions.
foreach std = [14, 20, 23] in {
  defm cxx#std#_constexpr_body_invalid_stmt : CXXCompat<
    "use of this statement in a constexpr %select{function|constructor}0 is"
    "\n" "警告：在 constexpr %select{函数|构造函数}0中使用此语句是", std>;
}

def note_previous_decl : Note<"%0 declared here"
  "\n" "提示：%0 在此声明">;
def note_entity_declared_at : Note<"%0 declared here"
  "\n" "提示：%0 在此声明">;
def note_callee_decl : Note<"%0 declared here"
  "\n" "提示：%0 在此声明">;
def note_defined_here : Note<"%0 defined here"
  "\n" "提示：%0 在此定义">;

// For loop analysis
def warn_variables_not_in_loop_body : Warning<
  "variable%select{s| %1|s %1 and %2|s %1, %2, and %3|s %1, %2, %3, and %4}0 "
  "used in loop condition not modified in loop body"
  "\n" "警告：循环条件中使用的%select{变量|变量 %1|变量 %1 和 %2|变量 %1、%2 和 %3|变量 %1、%2、%3 和 %4}0"
  "未在循环体中修改">,
  InGroup<ForLoopAnalysis>, DefaultIgnore;
def warn_redundant_loop_iteration : Warning<
  "variable %0 is %select{decremented|incremented}1 both in the loop header "
  "and in the loop body"
  "\n" "警告：变量 %0 在循环头和循环体中均被%select{递减|递增}1">,
  InGroup<ForLoopAnalysis>, DefaultIgnore;
def note_loop_iteration_here : Note<"%select{decremented|incremented}0 here"
  "\n" "提示：%select{递减|递增}0在此处">;

def warn_duplicate_enum_values : Warning<
  "element %0 has been implicitly assigned %1 which another element has "
  "been assigned"
  "\n" "警告：元素 %0 被隐式赋予 %1，另一个元素已被赋予该值">, InGroup<DiagGroup<"duplicate-enum">>, DefaultIgnore;
def note_duplicate_element : Note<"element %0 also has value %1"
  "\n" "提示：元素 %0 也具有值 %1">;

// Absolute value functions
def warn_unsigned_abs : Warning<
  "taking the absolute value of unsigned type %0 has no effect"
  "\n" "警告：对无符号类型 %0 取绝对值无效">,
  InGroup<AbsoluteValue>;
def note_remove_abs : Note<
  "remove the call to '%0' since unsigned values cannot be negative"
  "\n" "提示：请移除对 '%0' 的调用，因为无符号值不能为负">;
def warn_abs_too_small : Warning<
  "absolute value function %0 given an argument of type %1 but has parameter "
  "of type %2 which may cause truncation of value"
  "\n" "警告：绝对值函数 %0 接受类型为 %1 的参数，但其参数类型为 %2，可能导致值被截断">, InGroup<AbsoluteValue>;
def warn_wrong_absolute_value_type : Warning<
  "using %select{integer|floating point|complex}1 absolute value function %0 "
  "when argument is of %select{integer|floating point|complex}2 type"
  "\n" "警告：使用%select{整数|浮点|复数}1绝对值函数 %0，而参数是%select{整数|浮点|复数}2类型">,
  InGroup<AbsoluteValue>;
def note_replace_abs_function : Note<"use function '%0' instead"
  "\n" "提示：请改用函数 '%0'">;
def warn_pointer_abs : Warning<
  "taking the absolute value of %select{pointer|function|array}0 type %1 is suspicious"
  "\n" "警告：对%select{指针|函数|数组}0类型 %1 取绝对值值得怀疑">,
  InGroup<AbsoluteValue>;

def warn_max_unsigned_zero : Warning<
  "taking the max of "
  "%select{a value and unsigned zero|unsigned zero and a value}0 "
  "is always equal to the other value"
  "\n" "警告：取%select{某个值与无符号零|无符号零与某个值}0的最大值总是等于另一个值">,
  InGroup<MaxUnsignedZero>;
def note_remove_max_call : Note<
  "remove call to max function and unsigned zero argument"
  "\n" "提示：请移除对 max 函数和无符号零参数的调用">;

def warn_infinite_recursive_function : Warning<
  "all paths through this function will call itself"
  "\n" "警告：此函数的所有路径都会调用自身">,
  InGroup<InfiniteRecursion>, DefaultIgnore;

def warn_comma_operator : Warning<"possible misuse of comma operator here"
  "\n" "警告：此处可能误用了逗号运算符">,
  InGroup<DiagGroup<"comma">>, DefaultIgnore;
def note_cast_to_void : Note<"cast expression to void to silence warning"
  "\n" "提示：将表达式转换为 void 以消除警告">;
def note_cast_operand_to_int : Note<"cast one or both operands to int to silence this warning"
  "\n" "提示：将一个或两个操作数转换为 int 以消除此警告">;

// Constant expressions
def err_expr_not_ice : Error<
  "expression is not an %select{integer|integral}0 constant expression"
  "\n" "错误：表达式不是%select{整数|整型}0常量表达式">;
def ext_expr_not_ice : Extension<
  "expression is not an %select{integer|integral}0 constant expression; "
  "folding it to a constant is a GNU extension"
  "\n" "警告：表达式不是%select{整数|整型}0常量表达式；将其折叠为常量是 GNU 扩展">, InGroup<GNUFoldingConstant>;
def err_typecheck_converted_constant_expression : Error<
  "value of type %0 is not implicitly convertible to %1"
  "\n" "错误：类型 %0 的值不能隐式转换为 %1">;
def err_typecheck_converted_constant_expression_disallowed : Error<
  "conversion from %0 to %1 is not allowed in a converted constant expression"
  "\n" "错误：转换常量表达式中不允许从 %0 转换为 %1">;
def err_typecheck_converted_constant_expression_indirect : Error<
  "conversion from %0 to %1 in converted constant expression would "
  "bind reference to a temporary"
  "\n" "错误：转换常量表达式中从 %0 到 %1 的转换会将引用绑定到临时对象">;

def select_cce_kind : TextSubstitution<
  "%select{case value|enumerator value|non-type template argument|non-type parameter of template template parameter|"
  "array size|explicit specifier argument|noexcept specifier argument|"
  "call to 'size()'|call to 'data()'|pack index}0"
  "\n" "%select{case 值|枚举项值|非类型模板实参|模板模板参数的非类型形参|"
  "数组大小|explicit 说明符实参|noexcept 说明符实参|"
  "对 'size()' 的调用|对 'data()' 的调用|包索引}0">;
def err_expr_not_cce : Error<
  "%sub{select_cce_kind}0 is not a constant expression"
  "\n" "错误：%sub{select_cce_kind}0不是常量表达式">;
def ext_cce_narrowing : ExtWarn<
  "%sub{select_cce_kind}0 %select{cannot be narrowed from "
  "type %2 to %3|evaluates to %2, which cannot be narrowed to type %3}1"
  "\n" "警告：%sub{select_cce_kind}0%select{无法从类型 %2 窄化到 %3|"
  "求值为 %2，无法窄化到类型 %3}1">,
  InGroup<CXX11Narrowing>, DefaultError, SFINAEFailure;
def err_ice_not_integral : Error<
  "%select{integer|integral}1 constant expression must have "
  "%select{integer|integral or unscoped enumeration}1 type, not %0"
  "\n" "错误：%select{整数|整型}1常量表达式必须具有"
  "%select{整数|整型或无作用域枚举}1类型，而不是 %0">;
def err_ice_incomplete_type : Error<
  "integral constant expression has incomplete class type %0"
  "\n" "错误：整型常量表达式具有不完整的类类型 %0">;
def err_ice_explicit_conversion : Error<
  "integral constant expression requires explicit conversion from %0 to %1"
  "\n" "错误：整型常量表达式需要从 %0 到 %1 的显式转换">;
def note_ice_conversion_here : Note<
  "conversion to %select{integral|enumeration}0 type %1 declared here"
  "\n" "提示：转换为%select{整型|枚举}0类型 %1 的转换在此声明">;
def note_alignment_invalid_type : Note<
  "floating point types are not allowed here"
  "\n" "提示：此处不允许浮点类型">;
def note_alignment_invalid_member_pointer : Note<
  "member pointers are not allowed here"
  "\n" "提示：此处不允许成员指针">;
def note_alignment_invalid_function_pointer : Note<
  "function pointers are not allowed here"
  "\n" "提示：此处不允许函数指针">;
def err_ice_ambiguous_conversion : Error<
  "ambiguous conversion from type %0 to an integral or unscoped "
  "enumeration type"
  "\n" "错误：从类型 %0 到整型或无作用域枚举类型的转换存在歧义">;
def err_ice_too_large : Error<
  "integer constant expression evaluates to value %0 that cannot be "
  "represented in a %1-bit %select{signed|unsigned}2 integer type"
  "\n" "错误：整型常量表达式求值为值 %0，该值无法用 %1 位的%select{有符号|无符号}2整数类型表示">;
def err_expr_not_string_literal : Error<"expression is not a string literal"
  "\n" "错误：表达式不是字符串字面量">;
def note_constexpr_assert_failed : Note<
  "assertion failed during evaluation of constant expression"
  "\n" "提示：常量表达式求值期间断言失败">;
def err_expansion_size_expr_not_ice : Error<
  "expansion statement size is not a constant expression"
  "\n" "错误：展开语句的大小不是常量表达式">;
def err_iterating_expansion_stmt_unsupported : Error<
  "iterating expansion statements are not yet supported"
  "\n" "错误：尚不支持迭代展开语句">;

// Semantic analysis of constant literals.
def ext_predef_outside_function : Warning<
  "predefined identifier is only valid inside function"
  "\n" "警告：预定义标识符仅在函数内部有效">,
  InGroup<DiagGroup<"predefined-identifier-outside-function">>;
def ext_init_from_predefined
    : ExtWarn<"initializing an array from a %0 predefined identifier is a "
              "Microsoft extension"
              "\n" "警告：从 %0 预定义标识符初始化数组是 Microsoft 扩展">,
      InGroup<MicrosoftInitFromPredefined>;
def ext_string_literal_from_predefined : ExtWarn<
  "expansion of predefined identifier '%0' to a string literal is a Microsoft extension"
  "\n" "警告：将预定义标识符 '%0' 展开为字符串字面量是 Microsoft 扩展">,
  InGroup<MicrosoftStringLiteralFromPredefined>;
def warn_float_overflow : Warning<
  "magnitude of floating-point constant too large for type %0; maximum is %1"
  "\n" "警告：浮点常量的数量级对于类型 %0 来说太大；最大为 %1">,
   InGroup<LiteralRange>;
def warn_float_underflow : Warning<
  "magnitude of floating-point constant too small for type %0; minimum is %1"
  "\n" "警告：浮点常量的数量级对于类型 %0 来说太小；最小为 %1">,
  InGroup<LiteralRange>;
def warn_float_compare_literal : Warning<
  "floating-point comparison is always %select{true|false}0; "
  "constant cannot be represented exactly in type %1"
  "\n" "警告：浮点比较总是%select{为真|为假}0；常量无法在类型 %1 中精确表示">,
  InGroup<LiteralRange>;
def warn_double_const_requires_fp64 : Warning<
  "double precision constant requires %select{cl_khr_fp64|cl_khr_fp64 and __opencl_c_fp64}0, "
  "casting to single precision"
  "\n" "警告：双精度常量需要%select{cl_khr_fp64|cl_khr_fp64 和 __opencl_c_fp64}0，将转换为单精度">;
def err_half_const_requires_fp16 : Error<
  "half precision constant requires cl_khr_fp16"
  "\n" "错误：半精度常量需要 cl_khr_fp16">;

// C99 variable-length arrays
def ext_vla : Extension<"variable length arrays are a C99 feature"
  "\n" "警告：变长数组是 C99 特性">,
  InGroup<VLAExtension>;
// In C++ language modes, we warn by default as an extension, while in GNU++
// language modes, we warn as an extension but add the warning group to -Wall.
def ext_vla_cxx : ExtWarn<
  "variable length arrays in C++ are a Clang extension"
  "\n" "警告：C++ 中的变长数组是 Clang 扩展">,
  InGroup<VLACxxExtension>;
def ext_vla_cxx_in_gnu_mode : Extension<ext_vla_cxx.Summary>,
  InGroup<VLACxxExtension>;
def ext_vla_cxx_static_assert : ExtWarn<
  "variable length arrays in C++ are a Clang extension; did you mean to use "
  "'static_assert'?"
  "\n" "警告：C++ 中的变长数组是 Clang 扩展；您是指使用 'static_assert' 吗？">, InGroup<VLAUseStaticAssert>;
def ext_vla_cxx_in_gnu_mode_static_assert : Extension<
  ext_vla_cxx_static_assert.Summary>, InGroup<VLAUseStaticAssert>;
def warn_vla_used : Warning<"variable length array used"
  "\n" "警告：使用了变长数组">,
  InGroup<VLA>, DefaultIgnore;
def err_vla_in_sfinae : Error<
  "variable length array cannot be formed during template argument deduction"
  "\n" "错误：在模板实参推导期间不能形成变长数组">;
def err_array_star_in_function_definition : Error<
  "variable length array must be bound in function definition"
  "\n" "错误：变长数组必须在函数定义中确定边界">;
def err_vla_decl_in_file_scope : Error<
  "variable length array declaration not allowed at file scope"
  "\n" "错误：不允许在文件作用域声明变长数组">;
def err_vla_decl_has_static_storage : Error<
  "variable length array declaration cannot have 'static' storage duration"
  "\n" "错误：变长数组声明不能具有 'static' 存储期">;
def err_vla_decl_has_extern_linkage : Error<
  "variable length array declaration cannot have 'extern' linkage"
  "\n" "错误：变长数组声明不能具有 'extern' 链接">;
def ext_vla_folded_to_constant : ExtWarn<
  "variable length array folded to constant array as an extension"
  "\n" "警告：变长数组作为扩展被折叠为常量数组">,
  InGroup<GNUFoldingConstant>;
def err_vla_unsupported : Error<
  "variable length arrays are not supported %select{for the current target|in '%1'}0"
  "\n" "错误：不支持变长数组%select{对于当前目标|在 '%1' 中}0">;
def err_vla_in_coroutine_unsupported : Error<
  "variable length arrays in a coroutine are not supported"
  "\n" "错误：协程中的变长数组不受支持">;
def note_vla_unsupported : Note<
  "variable length arrays are not supported for the current target"
  "\n" "提示：当前目标不支持变长数组">;

// C99 variably modified types
def err_variably_modified_template_arg : Error<
  "variably modified type %0 cannot be used as a template argument"
  "\n" "错误：可变修改类型 %0 不能用作模板实参">;
def err_variably_modified_nontype_template_param : Error<
  "non-type template parameter of variably modified type %0"
  "\n" "错误：可变修改类型 %0 的非类型模板形参">;
def err_variably_modified_new_type : Error<
  "'new' cannot allocate object of variably modified type %0"
  "\n" "错误：'new' 无法分配可变修改类型 %0 的对象">;

// C99 Designated Initializers
def ext_designated_init : Extension<
  "designated initializers are a C99 feature"
  "\n" "警告：指定初始化器是 C99 特性">, InGroup<C99Designator>;
def err_array_designator_negative : Error<
  "array designator value '%0' is negative"
  "\n" "错误：数组设计符值 '%0' 为负数">;
def err_array_designator_empty_range : Error<
  "array designator range [%0, %1] is empty"
  "\n" "错误：数组设计符范围 [%0, %1] 为空">;
def err_array_designator_non_array : Error<
  "array designator cannot initialize non-array type %0"
  "\n" "错误：数组设计符无法初始化非数组类型 %0">;
def err_array_designator_too_large : Error<
  "array designator index (%0) exceeds array bounds (%1)"
  "\n" "错误：数组设计符索引 (%0) 超出数组边界 (%1)">;
def err_field_designator_non_aggr : Error<
  "field designator cannot initialize a "
  "%select{non-struct, non-union|non-class}0 type %1"
  "\n" "错误：字段设计符无法初始化%select{非结构体、非联合体|非类}0类型 %1">;
def err_field_designator_unknown : Error<
  "field designator %0 does not refer to any field in type %1"
  "\n" "错误：字段设计符 %0 不引用类型 %1 中的任何字段">;
def err_field_designator_nonfield : Error<
  "field designator %0 does not refer to a non-static data member"
  "\n" "错误：字段设计符 %0 不引用非静态数据成员">;
def note_field_designator_found : Note<"field designator refers here"
  "\n" "提示：字段设计符指向此处">;
def err_designator_for_scalar_or_sizeless_init : Error<
  "designator in initializer for %select{scalar|indivisible sizeless}0 "
  "type %1"
  "\n" "错误：%select{标量|不可分割的无大小}0类型 %1 的初始化器中的设计符">;
def warn_initializer_overrides : Warning<
  "initializer %select{partially |}0overrides prior initialization of "
  "this subobject"
  "\n" "警告：初始化器%select{部分|}0覆盖了此子对象的先前初始化">, InGroup<InitializerOverrides>;
def ext_initializer_overrides : ExtWarn<warn_initializer_overrides.Summary>,
  InGroup<InitializerOverrides>, SFINAEFailure;
def ext_initializer_union_overrides : ExtWarn<warn_initializer_overrides.Summary>,
  InGroup<InitializerOverrides>, DefaultError, SFINAEFailure;
def err_initializer_overrides_destructed : Error<
  "initializer would partially override prior initialization of object of "
  "type %1 with non-trivial destruction"
  "\n" "错误：初始化器将部分覆盖具有非平凡析构的类型 %1 对象的先前初始化">;
def note_previous_initializer : Note<
  "previous initialization %select{|with side effects }0is here"
  "%select{| (side effects will not occur at run time)}0"
  "\n" "提示：先前的初始化%select{|带有副作用 }0在此"
  "%select{|（副作用在运行时不会发生）}0">;
def err_designator_into_flexible_array_member : Error<
  "designator into flexible array member subobject"
  "\n" "错误：指向灵活数组成员子对象的设计符">;
def note_flexible_array_member : Note<
  "initialized flexible array member %0 is here"
  "\n" "提示：已初始化的灵活数组成员 %0 在此">;
def ext_flexible_array_init : Extension<
  "flexible array initialization is a GNU extension"
  "\n" "警告：灵活数组初始化是 GNU 扩展">, InGroup<GNUFlexibleArrayInitializer>;

// C++20 designated initializers
def ext_cxx_designated_init : Extension<
  "designated initializers are a C++20 extension"
  "\n" "警告：指定初始化器是 C++20 扩展">, InGroup<CXX20Designator>,
  SuppressInSystemMacro;
def warn_cxx17_compat_designated_init : Warning<
  "designated initializers are incompatible with C++ standards before C++20"
  "\n" "警告：指定初始化器与 C++20 之前的 C++ 标准不兼容">,
  InGroup<CXXPre20CompatPedantic>, DefaultIgnore;
