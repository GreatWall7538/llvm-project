  "arguments to __annotation must be wide string constants"
  "\n" "错误：__annotation 的实参必须是宽字符串常量">;

// CFString checking
def err_cfstring_literal_not_string_constant : Error<
  "CFString literal is not a string constant"
  "\n" "错误：CFString 字面量不是字符串常量">;
def warn_cfstring_truncated : Warning<
  "input conversion stopped due to an input byte that does not "
  "belong to the input codeset UTF-8"
  "\n" "警告：输入转换因输入字节不属于输入代码集 UTF-8 而停止">,
  InGroup<DiagGroup<"CFString-literal">>;

// os_log checking
// TODO: separate diagnostic for os_trace()
def err_os_log_format_not_string_constant : Error<
  "os_log() format argument is not a string constant"
  "\n" "错误：os_log() 格式实参不是字符串常量">;
def err_os_log_argument_too_big : Error<
  "os_log() argument %0 is too big (%1 bytes, max %2)"
  "\n" "错误：os_log() 实参 %0 太大（%1 字节，最大 %2）">;
def warn_os_log_format_narg : Error<
 "os_log() '%%n' format specifier is not allowed"
  "\n" "错误：os_log() 不允许 '%%n' 格式说明符">,
 DefaultError;

// Statements.
def err_continue_not_in_loop : Error<
  "'continue' statement not in loop statement"
  "\n" "错误：'continue' 语句不在循环语句中">;
def err_break_not_in_loop_or_switch : Error<
  "'break' statement not in loop or switch statement"
  "\n" "错误：'break' 语句不在循环或 switch 语句中">;
def err_break_continue_label_not_found : Error<
  "'%select{break|continue}0' label does not name an enclosing "
  "%select{loop or 'switch'|loop}0"
  "\n" "错误：'%select{break|continue}0' 标签未命名封闭的 "
  "%select{循环或 'switch'|循环}0">;
def err_continue_switch : Error<
  "label of 'continue' refers to a switch statement"
  "\n" "错误：'continue' 的标签引用 switch 语句">;
def err_omp_bind_required_on_loop : Error<
  "expected 'bind' clause for 'loop' construct without an enclosing OpenMP "
  "construct"
  "\n" "错误：对于没有封闭 OpenMP "
  "构造的 'loop' 构造，期望 'bind' 子句">;
def err_omp_loop_reduction_clause : Error<
  "'reduction' clause not allowed with '#pragma omp loop bind(teams)'"
  "\n" "错误：'reduction' 子句不允许与 '#pragma omp loop bind(teams)' 一起使用">;
def err_omp_split_counts_not_one_omp_fill : Error<
  "exactly one 'omp_fill' must appear in the 'counts' clause"
  "\n" "错误：'counts' 子句中必须恰好出现一个 'omp_fill'">;
def err_default_not_in_switch : Error<
  "'default' statement not in switch statement"
  "\n" "错误：'default' 语句不在 switch 语句中">;
def err_case_not_in_switch : Error<"'case' statement not in switch statement"
  "\n" "错误：'case' 语句不在 switch 语句中">;
def warn_bool_switch_condition : Warning<
  "switch condition has boolean value"
  "\n" "警告：switch 条件具有布尔值">, InGroup<SwitchBool>;
def warn_case_value_overflow : Warning<
  "overflow converting case value to switch condition type (%0 to %1)"
  "\n" "警告：将 case 值转换为 switch 条件类型时溢出（%0 到 %1）">,
  InGroup<Switch>;
def err_duplicate_case : Error<"duplicate case value '%0'"
  "\n" "错误：重复的 case 值 '%0'">;
def err_duplicate_case_differing_expr : Error<
  "duplicate case value: '%0' and '%1' both equal '%2'"
  "\n" "错误：重复的 case 值：'%0' 和 '%1' 都等于 '%2'">;
def warn_case_empty_range : Warning<"empty case range specified"
  "\n" "警告：指定了空的 case 范围">;
def warn_missing_case_for_condition :
  Warning<"no case matching constant switch condition '%0'"
  "\n" "警告：没有与常量 switch 条件 '%0' 匹配的 case">;
def err_loop_attr_conflict : Error<
  "conflicting loop attribute %0"
  "\n" "错误：冲突的循环特性 %0">;
def err_attribute_power_of_two_in_range : Error<
  "%0 attribute requires an integer argument which is a constant power of two "
  "between %1 and %2 inclusive; provided argument was %3"
  "\n" "错误：%0 特性要求一个介于 %1 和 %2（含）之间的 2 的常量幂的整数实参 "
  "；提供的实参是 %3">;

def warn_def_missing_case : Warning<"%plural{"
  "1:enumeration value %1 not explicitly handled in switch|"
  "2:enumeration values %1 and %2 not explicitly handled in switch|"
  "3:enumeration values %1, %2, and %3 not explicitly handled in switch|"
  ":%0 enumeration values not explicitly handled in switch: %1, %2, %3...}0"
  "\n" "警告：%plural{"
  "1:枚举值 %1 未在 switch 中显式处理|"
  "2:枚举值 %1 和 %2 未在 switch 中显式处理|"
  "3:枚举值 %1、%2 和 %3 未在 switch 中显式处理|"
  ":%0 个枚举值未在 switch 中显式处理：%1、%2、%3...}0">,
  InGroup<SwitchEnum>, DefaultIgnore;

def warn_missing_case : Warning<"%plural{"
  "1:enumeration value %1 not handled in switch|"
  "2:enumeration values %1 and %2 not handled in switch|"
  "3:enumeration values %1, %2, and %3 not handled in switch|"
  ":%0 enumeration values not handled in switch: %1, %2, %3...}0"
  "\n" "警告：%plural{"
  "1:枚举值 %1 未在 switch 中处理|"
  "2:枚举值 %1 和 %2 未在 switch 中处理|"
  "3:枚举值 %1、%2 和 %3 未在 switch 中处理|"
  ":%0 个枚举值未在 switch 中处理：%1、%2、%3...}0">,
  InGroup<Switch>;
def warn_switch_default : Warning<"'switch' missing 'default' label"
  "\n" "警告：'switch' 缺少 'default' 标签">,
  InGroup<SwitchDefault>, DefaultIgnore;

def warn_unannotated_fallthrough : Warning<
  "unannotated fall-through between switch labels"
  "\n" "警告：switch 标签之间未注释的落穿">,
  InGroup<ImplicitFallthrough>, DefaultIgnore;
def warn_unannotated_fallthrough_per_function : Warning<
  "unannotated fall-through between switch labels in partly-annotated "
  "function"
  "\n" "警告：在部分注释的函数中，switch 标签之间未注释的落穿">, InGroup<ImplicitFallthroughPerFunction>, DefaultIgnore;
def note_insert_fallthrough_fixit : Note<
  "insert '%0;' to silence this warning"
  "\n" "提示：插入 '%0;' 以消除此警告">;
def note_insert_break_fixit : Note<
  "insert 'break;' to avoid fall-through"
  "\n" "提示：插入 'break;' 以避免落穿">;
def err_fallthrough_attr_wrong_target : Error<
  "%0 attribute is only allowed on empty statements"
  "\n" "错误：%0 特性只允许用于空语句">;
def note_fallthrough_insert_semi_fixit : Note<"did you forget ';'?"
  "\n" "提示：您是否忘记 ';'？">;
def err_fallthrough_attr_outside_switch : Error<
  "fallthrough annotation is outside switch statement"
  "\n" "错误：落穿注释在 switch 语句之外">;
def err_fallthrough_attr_invalid_placement : Error<
  "fallthrough annotation does not directly precede switch label"
  "\n" "错误：落穿注释没有直接位于 switch 标签之前">;

def warn_unreachable_default : Warning<
  "default label in switch which covers all enumeration values"
  "\n" "警告：switch 中覆盖所有枚举值的 default 标签">,
  InGroup<CoveredSwitchDefault>, DefaultIgnore;
def warn_not_in_enum : Warning<"case value not in enumerated type %0"
  "\n" "警告：case 值不在枚举类型 %0 中">,
  InGroup<Switch>;
def warn_not_in_enum_assignment : Warning<"integer constant not in range "
  "of enumerated type %0"
  "\n" "警告：整数常量不在 "
  "枚举类型 %0 的范围内">, InGroup<DiagGroup<"assign-enum">>, DefaultIgnore;
def err_typecheck_statement_requires_scalar : Error<
  "statement requires expression of scalar type (%0 invalid)"
  "\n" "错误：语句要求标量类型的表达式（%0 无效）">;
def err_typecheck_statement_requires_integer : Error<
  "statement requires expression of integer type (%0 invalid)"
  "\n" "错误：语句要求整数类型的表达式（%0 无效）">;
def err_multiple_default_labels_defined : Error<
  "multiple default labels in one switch"
  "\n" "错误：一个 switch 中有多个 default 标签">;
def err_switch_multiple_conversions : Error<
  "multiple conversions from switch condition type %0 to an integral or "
  "enumeration type"
  "\n" "错误：从 switch 条件类型 %0 到整数或 "
  "枚举类型有多个转换">;
def note_switch_conversion : Note<
  "conversion to %select{integral|enumeration}0 type %1"
  "\n" "提示：转换为%select{整数|枚举}0类型 %1">;
def err_switch_explicit_conversion : Error<
  "switch condition type %0 requires explicit conversion to %1"
  "\n" "错误：switch 条件类型 %0 需要显式转换为 %1">;
def err_switch_incomplete_class_type : Error<
  "switch condition has incomplete class type %0"
  "\n" "错误：switch 条件具有不完整类类型 %0">;

// TODO: It ought to be possible to refactor these to be a single warning that
// uses %enum_select.
def warn_empty_if_body : Warning<
  "if statement has empty body"
  "\n" "警告：if 语句具有空主体">, InGroup<EmptyBody>;
def warn_empty_for_body : Warning<
  "for loop has empty body"
  "\n" "警告：for 循环具有空主体">, InGroup<EmptyBody>;
def warn_empty_range_based_for_body : Warning<
  "range-based for loop has empty body"
  "\n" "警告：基于范围的 for 循环具有空主体">, InGroup<EmptyBody>;
def warn_empty_while_body : Warning<
  "while loop has empty body"
  "\n" "警告：while 循环具有空主体">, InGroup<EmptyBody>;
def warn_empty_switch_body : Warning<
  "switch statement has empty body"
  "\n" "警告：switch 语句具有空主体">, InGroup<EmptyBody>;
def warn_empty_defer_body : Warning<
  "defer statement has empty body"
  "\n" "警告：defer 语句具有空主体">, InGroup<EmptyBody>;
def note_empty_body_on_separate_line : Note<
  "put the semicolon on a separate line to silence this warning"
  "\n" "提示：将分号放在单独的一行上以消除此警告">;

def err_va_start_captured_stmt : Error<
  "'va_start' cannot be used in a captured statement"
  "\n" "错误：'va_start' 不能在捕获语句中使用">;
def err_va_start_outside_function : Error<
  "'va_start' cannot be used outside a function"
  "\n" "错误：'va_start' 不能在函数之外使用">;
def err_va_start_fixed_function : Error<
  "'va_start' used in function with fixed args"
  "\n" "错误：在具有固定实参的函数中使用了 'va_start'">;
def err_va_start_used_in_wrong_abi_function : Error<
  "'va_start' used in %select{System V|Win64}0 ABI function"
  "\n" "错误：在%select{System V|Win64}0 ABI 函数中使用了 'va_start'">;
def err_ms_va_start_used_in_sysv_function : Error<
  "'__builtin_ms_va_start' used in System V ABI function"
  "\n" "错误：在 System V ABI 函数中使用了 '__builtin_ms_va_start'">;
def warn_second_arg_of_va_start_not_last_non_variadic_param : Warning<
  "second argument to 'va_start' is not the last non-variadic parameter"
  "\n" "警告：'va_start' 的第二个实参不是最后一个非可变参数形参">,
  InGroup<Varargs>;
def warn_c17_compat_ellipsis_only_parameter : Warning<
  "'...' as the only parameter of a function is incompatible with C standards "
  "before C23"
  "\n" "警告：将 '...' 作为函数的唯一形参与 C23 之前的 C 标准 "
  "不兼容">, DefaultIgnore, InGroup<CPre23Compat>;
def warn_c17_compat_va_start_one_arg : Warning<
  "passing only one argument to 'va_start' is incompatible with C standards "
  "before C23"
  "\n" "警告：仅向 'va_start' 传递一个实参与 C23 之前的 C 标准 "
  "不兼容">, DefaultIgnore, InGroup<CPre23Compat>;
def warn_va_start_type_is_undefined : Warning<
  "passing %select{an object that undergoes default argument promotion|"
  "an object of reference type|a parameter declared with the 'register' "
  "keyword}0 to 'va_start' has undefined behavior"
  "\n" "警告：将%select{经受默认实参提升的对象|"
  "引用类型的对象|使用 'register' "
  "关键字声明的形参}0传递给 'va_start' 具有未定义行为">, InGroup<Varargs>;
def err_first_argument_to_va_arg_not_of_type_va_list : Error<
  "first argument to 'va_arg' is of type %0 and not 'va_list'"
  "\n" "错误：'va_arg' 的第一个实参是类型 %0 而不是 'va_list'">;
def err_second_parameter_to_va_arg_incomplete: Error<
  "second argument to 'va_arg' is of incomplete type %0"
  "\n" "错误：'va_arg' 的第二个实参是不完整类型 %0">;
def err_second_parameter_to_va_arg_abstract: Error<
  "second argument to 'va_arg' is of abstract type %0"
  "\n" "错误：'va_arg' 的第二个实参是抽象类型 %0">;
def warn_second_parameter_to_va_arg_not_pod : Warning<
  "second argument to 'va_arg' is of non-POD type %0"
  "\n" "警告：'va_arg' 的第二个实参是非 POD 类型 %0">,
  InGroup<NonPODVarargs>, DefaultError;
def warn_second_parameter_to_va_arg_ownership_qualified : Warning<
  "second argument to 'va_arg' is of ARC ownership-qualified type %0"
  "\n" "警告：'va_arg' 的第二个实参是 ARC 所有权限定类型 %0">,
  InGroup<NonPODVarargs>, DefaultError;
def warn_second_parameter_to_va_arg_never_compatible : Warning<
  "second argument to 'va_arg' is of promotable type %0; this va_arg has "
  "undefined behavior because arguments will be promoted to %1"
  "\n" "警告：'va_arg' 的第二个实参是可提升类型 %0；此 va_arg 具有 "
  "未定义行为，因为实参将被提升为 %1">, InGroup<Varargs>;
def warn_second_parameter_to_va_arg_array : Warning<
  "second argument to 'va_arg' is of array type %0; "
  "this va_arg has undefined behavior because arguments "
  "will never be compatible with array type"
  "\n" "警告：'va_arg' 的第二个实参是数组类型 %0； "
  "此 va_arg 具有未定义行为，因为实参 "
  "永远不会与数组类型兼容">, InGroup<Varargs>;

def warn_return_missing_expr : Warning<
  "non-void %select{function|method}1 %0 should return a value"
  "\n" "警告：非 void %select{函数|方法}1 %0 应返回值">, DefaultError,
  InGroup<ReturnMismatch>;
def ext_return_missing_expr : ExtWarn<
  "non-void %select{function|method}1 %0 should return a value"
  "\n" "警告：非 void %select{函数|方法}1 %0 应返回值">, DefaultError,
  InGroup<ReturnMismatch>;
def ext_return_has_expr : ExtWarn<
  "%select{void function|void method|constructor|destructor}1 %0 "
  "should not return a value"
  "\n" "警告：%select{void 函数|void 方法|构造函数|析构函数}1 %0 "
  "不应返回值">,
  DefaultError, InGroup<ReturnMismatch>;
def ext_return_has_void_expr : Extension<
  "void %select{function|method|block}1 %0 should not return void expression"
  "\n" "警告：void%select{函数|方法|块}1 %0 不应返回 void 表达式">;
def err_return_init_list : Error<
  "%select{void function|void method|constructor|destructor}1 %0 "
  "must not return a value"
  "\n" "错误：%select{void 函数|void 方法|构造函数|析构函数}1 %0 "
  "不得返回值">;
def err_ctor_dtor_returns_void : Error<
  "%select{constructor|destructor}1 %0 must not return void expression"
  "\n" "错误：%select{构造函数|析构函数}1 %0 不得返回 void 表达式">;
def warn_noreturn_function_has_return_expr : Warning<
  "function %0 declared 'noreturn' should not return"
  "\n" "警告：声明为 'noreturn' 的函数 %0 不应返回">,
  InGroup<InvalidNoreturn>;
def warn_noreturn_has_return_expr : Warning<
  "%select{function|block|lambda|coroutine}0 "
  "declared 'noreturn' should not return"
  "\n" "警告：%select{函数|块|lambda|协程}0 "
  "声明为 'noreturn' 不应返回">,
  InGroup<InvalidNoreturn>;
def err_noreturn_has_return_expr : Error<
  "%select{function|block|lambda|coroutine}0 "
  "declared 'noreturn' should not return"
  "\n" "错误：%select{函数|块|lambda|协程}0 "
  "声明为 'noreturn' 不应返回">;
def warn_noreturn_coroutine : Warning<
  "coroutine %0 cannot be declared 'noreturn' as it always returns a coroutine handle"
  "\n" "警告：协程 %0 不能声明为 'noreturn'，因为它总是返回协程句柄">,
  InGroup<InvalidNoreturn>;
def err_carries_dependency_missing_on_first_decl : Error<
  "%select{function|parameter}0 declared '[[carries_dependency]]' "
  "after its first declaration"
  "\n" "错误：%select{函数|形参}0在首次声明之后 "
  "声明为 '[[carries_dependency]]'">;
def note_carries_dependency_missing_first_decl : Note<
  "declaration missing '[[carries_dependency]]' attribute is here"
  "\n" "提示：缺少 '[[carries_dependency]]' 特性的声明在此处">;
def err_carries_dependency_param_not_function_decl : Error<
  "'[[carries_dependency]]' attribute only allowed on parameter in a function "
  "declaration or lambda"
  "\n" "错误：'[[carries_dependency]]' 特性只允许用在函数 "
  "声明或 lambda 的形参上">;
def err_block_not_allowed_on : Error<
  "'__block' is not allowed on %enum_select<NotAllowedBlockVarReason>{"
  "%NonlocalVariable{a nonlocal variable}|"
  "%StaticLocalVariable{a static local variable}|"
  "%CppStaticDataMember{a C++ static data member}|"
  "%ObjCInstanceVariable{an Objective-C instance variable}|"
  "%RegisterVariable{a 'register' variable}|"
  "%VariablyModifiedType{a declaration with a variably modified type}|"
  "}0"
  "\n" "错误：'__block' 不允许用于%enum_select<NotAllowedBlockVarReason>{"
  "%NonlocalVariable{非局部变量}|"
  "%StaticLocalVariable{静态局部变量}|"
  "%CppStaticDataMember{C++ 静态数据成员}|"
  "%ObjCInstanceVariable{Objective-C 实例变量}|"
  "%RegisterVariable{'register' 变量}|"
  "%VariablyModifiedType{带可变修改类型的声明}|"
  "}0">;
def err_sizeless_nonlocal : Error<
  "non-local variable with sizeless type %0"
  "\n" "错误：具有无大小类型 %0 的非局部变量">;

def err_vec_masked_load_store_ptr : Error<
 "%ordinal0 argument must be a %1"
  "\n" "错误：%ordinal0实参必须是 %1">;
def err_vec_masked_load_store_size : Error<
 "all arguments to %0 must have the same number of elements (was %1 and %2)"
  "\n" "错误：%0 的所有实参必须具有相同数量的元素（是 %1 和 %2）">;

def err_vec_builtin_non_vector : Error<
 "%select{first two|all}1 arguments to %0 must be vectors"
  "\n" "错误：%0 的%select{前两个|所有}1实参必须是向量">;
def err_vec_builtin_incompatible_vector : Error<
  "%select{first two|all|last two}1 arguments to %0 must have the same type"
  "\n" "错误：%0 的%select{前两个|所有|最后两个}1实参必须具有相同的类型">;
def err_vsx_builtin_nonconstant_argument : Error<
  "argument %0 to %1 must be a 2-bit unsigned literal (i.e. 0, 1, 2 or 3)"
  "\n" "错误：%1 的实参 %0 必须是 2 位无符号字面量（即 0、1、2 或 3）">;

def err_shufflevector_nonconstant_argument : Error<
  "index for __builtin_shufflevector must be a constant integer"
  "\n" "错误：__builtin_shufflevector 的索引必须是常量整数">;
def err_shufflevector_argument_too_large : Error<
  "index for __builtin_shufflevector must be less than the total number "
  "of vector elements"
  "\n" "错误：__builtin_shufflevector 的索引必须小于向量元素的总数">;
def err_shufflevector_minus_one_is_undefined_behavior_constexpr : Error<
  "index for __builtin_shufflevector not within the bounds of the input vectors; index of -1 found at position %0 is not permitted in a constexpr context"
  "\n" "错误：__builtin_shufflevector 的索引不在输入向量的范围内；在常量表达式上下文中不允许在位置 %0 处找到 -1 索引">;

def err_convertvector_non_vector : Error<
  "first argument to __builtin_convertvector must be a vector"
  "\n" "错误：__builtin_convertvector 的第一个实参必须是向量">;
def err_convertvector_constexpr_unsupported_vector_cast : Error<
  "unsupported vector cast from %0 to %1 in a constant expression"
  "\n" "错误：常量表达式中不支持的从 %0 到 %1 的向量转换">;
def err_builtin_non_vector_type : Error<
  "%0 argument to %1 must be of vector type"
  "\n" "错误：%1 的 %0 实参必须是向量类型">;
def err_convertvector_incompatible_vector : Error<
  "first two arguments to __builtin_convertvector must have the same number of elements"
  "\n" "错误：__builtin_convertvector 的前两个实参必须具有相同数量的元素">;

def err_first_argument_to_cwsc_not_call : Error<
  "first argument to __builtin_call_with_static_chain must be a non-member call expression"
  "\n" "错误：__builtin_call_with_static_chain 的第一个实参必须是非成员调用表达式">;
def err_first_argument_to_cwsc_block_call : Error<
  "first argument to __builtin_call_with_static_chain must not be a block call"
  "\n" "错误：__builtin_call_with_static_chain 的第一个实参不能是块调用">;
