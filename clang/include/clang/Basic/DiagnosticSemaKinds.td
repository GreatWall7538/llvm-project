  "\n" "警告：变量 %0 被设置但未使用">,
                                 InGroup<UnusedButSetGlobal>,
                                 DefaultIgnore;
def warn_unused_local_typedef : Warning<
  "unused %select{typedef|type alias}0 %1"
  "\n" "警告：未使用的%select{typedef|类型别名}0 %1">,
