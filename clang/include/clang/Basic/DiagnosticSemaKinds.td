  warn_format_cmp_specifier_sign_mismatch.Summary>, InGroup<FormatPedantic>;
def note_format_cmp_with : Note<
  "comparing with this %select{specifier|format string}0"
  "\n" "提示：与此%select{说明符|格式字符串}0进行比较">;

def warn_null_arg : Warning<
  "null passed to a callee that requires a non-null argument"
  "\n" "警告：向需要非 null 实参的被调用方传递了 null">,
  InGroup<NonNull>;
def warn_null_ret : Warning<
  "null returned from %select{function|method}0 that requires a non-null return value"
  "\n" "警告：从需要非 null 返回值的%select{函数|方法}0返回了 null">,
  InGroup<NonNull>;

def err_lifetimebound_no_object_param : Error<
  "'lifetimebound' attribute cannot be applied; "
  "%select{non-|static |explicit object }0"
  "member function has no implicit object parameter"
  "\n" "错误：无法应用 'lifetimebound' 特性； "
  "%select{非|静态 |显式对象 }0"
  "成员函数没有隐式对象形参">;
def err_lifetimebound_ctor_dtor : Error<
  "'lifetimebound' attribute cannot be applied to a "
  "%select{constructor|destructor}0"
  "\n" "错误：'lifetimebound' 特性不能应用于 "
  "%select{构造函数|析构函数}0">;
def err_lifetimebound_parameter_void_return_type : Error<
  "'lifetimebound' attribute cannot be applied to a parameter of a function "
  "that returns void; did you mean 'lifetime_capture_by(X)'"
  "\n" "错误：'lifetimebound' 特性不能应用于返回 void 的函数的形参 "
  "；您是指 'lifetime_capture_by(X)' 吗">;
def err_lifetimebound_implicit_object_parameter_void_return_type : Error<
  "'lifetimebound' attribute cannot be applied to an implicit object "
  "parameter of a function that returns void; "
  "did you mean 'lifetime_capture_by(X)'"
  "\n" "错误：'lifetimebound' 特性不能应用于返回 void 的函数的隐式对象 "
  "形参； "
  "您是指 'lifetime_capture_by(X)' 吗">;

// CHECK: returning address/reference of stack memory
def warn_ret_stack_addr_ref : Warning<
  "%select{address of|reference to}0 stack memory associated with "
  "%select{local variable|parameter|compound literal}2 %1 "
  "%select{returned|passed to musttail function}3"
  "\n" "警告：%select{地址|引用}0与%select{局部变量|形参|复合字面量}2 %1 关联的栈内存被%select{返回|传递给 musttail 函数}3">,
  InGroup<ReturnStackAddress>;
def warn_ret_local_temp_addr_ref : Warning<
  "returning %select{address of|reference to}0 local temporary object"
  "\n" "警告：返回局部临时对象的%select{地址|引用}0">,
  InGroup<ReturnStackAddress>;
def warn_musttail_local_temp_addr_ref : Warning<
  "passing %select{address of|reference to}0 local temporary object to musttail function"
  "\n" "警告：将局部临时对象的%select{地址|引用}0传递给 musttail 函数">,
  InGroup<ReturnStackAddress>;
def err_ret_local_temp_ref : Error<
  "returning reference to local temporary object"
  "\n" "错误：返回对局部临时对象的引用">;
def warn_ret_addr_label : Warning<
  "returning address of label, which is local"
  "\n" "警告：返回标签的地址，而标签是局部的">,
  InGroup<ReturnStackAddress>;
def err_ret_local_block : Error<
  "returning block that lives on the local stack"
  "\n" "错误：返回位于局部栈上的块">;
def note_local_var_initializer : Note<
  "%select{via initialization of|binding reference}0 variable "
  "%select{%2 |}1here"
  "\n" "提示：%select{通过初始化|绑定引用}0变量 "
  "%select{%2 |}1此处">;
def note_lambda_capture_initializer : Note<
  "%select{implicitly |}2captured%select{| by reference}3"
  "%select{%select{ due to use|}2 here|"
  " via initialization of lambda capture %0}1"
  "\n" "提示：%select{隐式|}2捕获%select{|按引用}3"
  "%select{%select{ 由于在此处使用|}2|"
  " 通过 lambda 捕获 %0 的初始化}1">;
def note_init_with_default_member_initializer : Note<
  "initializing field %0 with default member initializer"
  "\n" "提示：使用默认成员初始化器初始化字段 %0">;
def note_init_with_default_argument : Note<
  "initializing parameter %0 with default argument"
  "\n" "提示：使用默认实参初始化形参 %0">;

// Check for initializing a member variable with the address or a reference to
// a constructor parameter.
def warn_bind_ref_member_to_parameter : Warning<
  "binding reference member %0 to stack allocated "
  "%select{variable|parameter}2 %1"
  "\n" "警告：将引用成员 %0 绑定到栈分配的 "
  "%select{变量|形参}2 %1">, InGroup<DanglingField>;
def warn_init_ptr_member_to_parameter_addr : Warning<
  "initializing pointer member %0 with the stack address of "
  "%select{variable|parameter}2 %1"
  "\n" "警告：使用 "
  "%select{变量|形参}2 %1 的栈地址初始化指针成员 %0">, InGroup<DanglingField>;
def note_ref_or_ptr_member_declared_here : Note<
  "%select{reference|pointer}0 member declared here"
  "\n" "提示：%select{引用|指针}0成员在此声明">;

def err_dangling_member : Error<
  "%select{reference|backing array for 'std::initializer_list'}2 "
  "%select{|subobject of }1member %0 "
  "%select{binds to|is}2 a temporary object "
  "whose lifetime would be shorter than the lifetime of "
  "the constructed object"
  "\n" "错误：%select{引用|'std::initializer_list' 的后备数组}2 "
  "%select{|子对象 }1成员 %0 "
  "%select{绑定到|是}2一个临时对象 "
  "，其生命周期将比 "
  "构造对象的生命周期短">;
def warn_dangling_member : Warning<
  "%select{reference|backing array for 'std::initializer_list'}2 "
  "%select{|subobject of }1member %0 "
  "%select{binds to|is}2 a temporary object "
  "whose lifetime is shorter than the lifetime of the constructed object"
  "\n" "警告：%select{引用|'std::initializer_list' 的后备数组}2 "
  "%select{|子对象 }1成员 %0 "
  "%select{绑定到|是}2一个临时对象 "
  "，其生命周期比构造对象的生命周期短">,
  InGroup<DanglingField>;
def warn_dangling_lifetime_pointer_member : Warning<
  "initializing pointer member %0 to point to a temporary object "
  "whose lifetime is shorter than the lifetime of the constructed object"
  "\n" "警告：初始化指针成员 %0 以指向一个临时对象 "
  "，其生命周期比构造对象的生命周期短">,
  InGroup<DanglingGsl>;
def note_lifetime_extending_member_declared_here : Note<
  "%select{%select{reference|'std::initializer_list'}0 member|"
  "member with %select{reference|'std::initializer_list'}0 subobject}1 "
  "declared here"
  "\n" "提示：%select{%select{reference|'std::initializer_list'}0成员|"
  "带%select{reference|'std::initializer_list'}0子对象的成员}1 "
  "在此声明">;
def warn_dangling_variable : Warning<
  "%select{temporary %select{whose address is used as value of|"
  "%select{|implicitly }2bound to}4 "
  "%select{%select{|reference }4member of local variable|"
  "local %select{variable|reference}4}1|"
  "array backing "
  "%select{initializer list subobject of local variable|"
  "local initializer list}1}0 "
  "%select{%3 |}2will be destroyed at the end of the full-expression"
  "\n" "警告：%select{临时对象 %select{其地址被用作|"
  "%select{|隐式}2绑定到}4 "
  "%select{%select{|引用 }4局部变量的成员|"
  "局部%select{变量|引用}4}1|"
  "数组后备 "
  "%select{局部变量的初始化器列表子对象|"
  "局部初始化器列表}1}0 "
  "%select{%3 |}2将在完整表达式结束时被销毁">,
  InGroup<Dangling>;
def warn_new_dangling_reference : Warning<
  "temporary bound to reference member of allocated object "
  "will be destroyed at the end of the full-expression"
  "\n" "警告：绑定到已分配对象的引用成员的临时对象 "
  "将在完整表达式结束时被销毁">,
  InGroup<DanglingField>;
def warn_dangling_lifetime_pointer : Warning<
  "object backing the pointer "
  "will be destroyed at the end of the full-expression"
  "\n" "警告：支撑指针的对象 "
  "将在完整表达式结束时被销毁">,
  InGroup<DanglingGsl>;
def warn_dangling_lifetime_pointer_assignment : Warning<"object backing the "
  "pointer %0 will be destroyed at the end of the full-expression"
  "\n" "警告：支撑 "
  "指针 %0 的对象将在完整表达式结束时被销毁">,
  InGroup<DanglingAssignmentGsl>;
def warn_new_dangling_initializer_list : Warning<
  "array backing %select{initializer list subobject of the allocated object|"
  "the allocated initializer list}0 will be destroyed at the end of the full-expression"
  "\n" "警告：数组后备%select{已分配对象的初始化器列表子对象|"
  "已分配的初始化器列表}0将在完整表达式结束时被销毁">,
  InGroup<DanglingInitializerList>;
def warn_dangling_pointer_assignment : Warning<
  "object backing %select{|the pointer }0%1 will be destroyed at the end of the full-expression"
  "\n" "警告：对象后备%select{|指针 }0%1将在完整表达式结束时被销毁">,
  InGroup<DanglingAssignment>;
def warn_dangling_reference_captured
    : Warning<"object whose reference is captured by %0 will be destroyed at "
              "the end of "
              "the full-expression"
  "\n" "警告：其引用被 %0 捕获的对象将在 "
              "完整表达式结束时"
              "被销毁">,
      InGroup<DanglingCapture>;
def warn_dangling_reference_captured_by_unknown : Warning<
   "object whose reference is captured will be destroyed at the end of "
   "the full-expression"
  "\n" "警告：其引用被捕获的对象将在 "
   "完整表达式结束时被销毁">,
   InGroup<DanglingCapture>;

// Diagnostics based on the Lifetime safety analysis.
def warn_lifetime_safety_use_after_scope : Warning<
   "%0 does not live long enough"
  "\n" "警告：%0 生命周期不够长">,
   InGroup<LifetimeSafetyUseAfterScope>, DefaultIgnore;
def warn_lifetime_safety_use_after_scope_moved : Warning<
   "%0 may not live long enough. "
   "This could be a false positive as the storage may have been moved later"
  "\n" "警告：%0 可能生命周期不够长。"
   "由于存储可能已在之后被移动，这可能是误报">,
   InGroup<LifetimeSafetyUseAfterScopeMoved>, DefaultIgnore;

def warn_lifetime_safety_use_after_free : Warning<
    "%0 does not live long enough"
  "\n" "警告：%0 生命周期不够长">,
    InGroup<LifetimeSafetyUseAfterFree>, DefaultIgnore;

def warn_lifetime_safety_return_stack_addr : Warning<
  "stack memory associated with %0 is returned"
  "\n" "警告：与 %0 关联的栈内存被返回">,
  InGroup<LifetimeSafetyReturnStackAddr>, DefaultIgnore;

def warn_lifetime_safety_return_stack_addr_moved : Warning<
  "stack memory associated with %0 may be returned later. "
  "This could be a false positive as the storage may have been moved. "
  "Consider moving first and then aliasing later to resolve the issue"
  "\n" "警告：与 %0 关联的栈内存可能在之后被返回。"
  "由于存储可能已被移动，这可能是误报。"
  "请考虑先移动再在之后进行别名化以解决此问题">,
  InGroup<LifetimeSafetyReturnStackAddrMoved>, DefaultIgnore;

def warn_lifetime_safety_invalidation
    : Warning<"%0 is later invalidated"
  "\n" "警告：%0 稍后失效">,
      InGroup<LifetimeSafetyInvalidation>,
      DefaultIgnore;
def warn_lifetime_safety_invalidated_field
    : Warning<"%0 escapes to the %1 and is later invalidated"
  "\n" "警告：%0 逃逸到 %1 并稍后失效">,
      InGroup<LifetimeSafetyInvalidation>,
      DefaultIgnore;
def warn_lifetime_safety_invalidated_global
    : Warning<"%0 escapes to the %1 and is later invalidated"
  "\n" "警告：%0 逃逸到 %1 并稍后失效">,
      InGroup<LifetimeSafetyInvalidation>,
      DefaultIgnore;

def warn_lifetime_safety_dangling_field
    : Warning<"stack memory associated with %0 escapes to the %1 which will dangle"
  "\n" "警告：与 %0 关联的栈内存逃逸到将悬垂的 %1">,
      InGroup<LifetimeSafetyDanglingField>,
      DefaultIgnore;
def warn_lifetime_safety_dangling_field_moved
    : Warning<"stack memory associated with %0 may escape to the %1 which will dangle. "
      "This could be a false positive as the storage may have been moved. "
      "Consider moving first and then aliasing later to resolve the issue"
  "\n" "警告：与 %0 关联的栈内存可能逃逸到将悬垂的 %1。"
      "由于存储可能已被移动，这可能是误报。"
      "请考虑先移动再在之后进行别名化以解决此问题">,
      InGroup<LifetimeSafetyDanglingFieldMoved>,
      DefaultIgnore;
def warn_lifetime_safety_dangling_global
    : Warning<"stack memory associated with %0 escapes to the %1 which will dangle"
  "\n" "警告：与 %0 关联的栈内存逃逸到将悬垂的 %1">,
      InGroup<LifetimeSafetyDanglingGlobal>,
      DefaultIgnore;
def warn_lifetime_safety_dangling_global_moved
    : Warning<"stack memory associated with %0 may escape to the %1 which will dangle. "
      "This could be a false positive as the storage may have been moved. "
      "Consider moving first and then aliasing later to resolve the issue"
  "\n" "警告：与 %0 关联的栈内存可能逃逸到将悬垂的 %1。"
      "由于存储可能已被移动，这可能是误报。"
      "请考虑先移动再在之后进行别名化以解决此问题">,
      InGroup<LifetimeSafetyDanglingGlobalMoved>,
      DefaultIgnore;

def warn_lifetime_safety_lifetimebound_violation
    : Warning<"could not verify that the return value can be lifetime bound to %select{an unnamed parameter|'%1'|the implicit this parameter}0"
  "\n" "警告：无法验证返回值可以生命周期绑定到%select{未命名形参|'%1'|隐式 this 形参}0">,
      InGroup<LifetimeSafetyLifetimeboundViolation>,
      DefaultIgnore;

def warn_lifetime_safety_intra_tu_misplaced_lifetimebound
    : Warning<"'lifetimebound' attribute on this definition is not visible to callers before the definition; add it to the declaration instead"
  "\n" "警告：此定义上的 'lifetimebound' 特性在定义之前对调用方不可见；请改为将其添加到声明中">,
      InGroup<LifetimeSafetyIntraTUMisplacedLifetimebound>,
      DefaultIgnore;

def warn_lifetime_safety_cross_tu_misplaced_lifetimebound
    : Warning<"'lifetimebound' attribute on this definition is not visible to callers in other translation units; add it to the declaration instead"
  "\n" "警告：此定义上的 'lifetimebound' 特性对其他翻译单元中的调用方不可见；请改为将其添加到声明中">,
      InGroup<LifetimeSafetyCrossTUMisplacedLifetimebound>,
      DefaultIgnore;

def warn_lifetime_safety_inapplicable_lifetimebound
    : Warning<"'lifetimebound' attribute has no effect on parameter of type %0. The attribute only applies to reference types, pointer types, and non-owner record types"
  "\n" "警告：'lifetimebound' 特性对类型 %0 的形参没有效果。该特性仅适用于引用类型、指针类型和非 owner 记录类型">,
      InGroup<LifetimeSafetyInapplicableLifetimebound>,
      DefaultIgnore;

def note_lifetime_safety_used_here : Note<"later used here"
  "\n" "提示：稍后在此处使用">;
def note_lifetime_safety_invalidated_here : Note<"%0 is invalidated here"
  "\n" "提示：%0 在此处失效">;
def note_lifetime_safety_destroyed_here : Note<"%0 is destroyed here"
  "\n" "提示：%0 在此处被销毁">;
def note_lifetime_safety_freed_here : Note<"%0 is freed here"
  "\n" "提示：%0 在此处被释放">;
def note_lifetime_safety_returned_here : Note<"returned here"
  "\n" "提示：在此处返回">;
def note_lifetime_safety_moved_here : Note<"potentially moved here"
  "\n" "提示：可能在此处被移动">;
def note_lifetime_safety_dangling_field_here: Note<"this field dangles"
  "\n" "提示：此字段悬垂">;
def note_lifetime_safety_dangling_global_here: Note<"this global dangles"
  "\n" "提示：此全局变量悬垂">;
def note_lifetime_safety_dangling_static_here: Note<"this static storage dangles"
  "\n" "提示：此静态存储悬垂">;
def note_lifetime_safety_escapes_to_field_here: Note<"escapes to this field"
  "\n" "提示：逃逸到此字段">;
def note_lifetime_safety_escapes_to_global_here: Note<"escapes to this global storage"
  "\n" "提示：逃逸到此全局存储">;
def note_lifetime_safety_escapes_to_static_storage_here: Note<"escapes to this static storage"
  "\n" "提示：逃逸到此静态存储">;
def note_lifetime_safety_lifetimebound_here: Note<"'lifetimebound' attribute appears here on the definition"
  "\n" "提示：'lifetimebound' 特性在此定义上出现">;
def note_lifetime_safety_aliases_storage : Note<"%0 aliases the storage of %1"
  "\n" "提示：%0 是 %1 存储的别名">;

def warn_lifetime_safety_intra_tu_param_suggestion
    : Warning<"parameter in intra-TU function should be marked "
              "[[clang::lifetimebound]]"
  "\n" "警告：intra-TU 函数中的形参应标记为 "
              "[[clang::lifetimebound]]">,
      InGroup<LifetimeSafetyIntraTUSuggestions>,
      DefaultIgnore;

def warn_lifetime_safety_cross_tu_param_suggestion
    : Warning<"parameter in cross-TU function should be marked "
              "[[clang::lifetimebound]]"
  "\n" "警告：cross-TU 函数中的形参应标记为 "
              "[[clang::lifetimebound]]">,
      InGroup<LifetimeSafetyCrossTUSuggestions>,
      DefaultIgnore;

def warn_lifetime_safety_intra_tu_ctor_param_suggestion
    : Warning<"parameter in intra-TU constructor should be marked "
              "[[clang::lifetimebound]]"
  "\n" "警告：intra-TU 构造函数中的形参应标记为 "
              "[[clang::lifetimebound]]">,
      InGroup<LifetimeSafetyIntraTUConstructorSuggestions>,
      DefaultIgnore;

def warn_lifetime_safety_cross_tu_ctor_param_suggestion
    : Warning<"parameter in cross-TU constructor should be marked "
              "[[clang::lifetimebound]]"
  "\n" "警告：cross-TU 构造函数中的形参应标记为 "
              "[[clang::lifetimebound]]">,
      InGroup<LifetimeSafetyCrossTUConstructorSuggestions>,
      DefaultIgnore;

def warn_lifetime_safety_intra_tu_this_suggestion
    : Warning<"implicit this in intra-TU function should be marked "
              "[[clang::lifetimebound]]"
  "\n" "警告：intra-TU 函数中的隐式 this 应标记为 "
              "[[clang::lifetimebound]]">,
      InGroup<LifetimeSafetyIntraTUSuggestions>,
      DefaultIgnore;

def warn_lifetime_safety_cross_tu_this_suggestion
    : Warning<"implicit this in cross-TU function should be marked "
              "[[clang::lifetimebound]]"
  "\n" "警告：cross-TU 函数中的隐式 this 应标记为 "
              "[[clang::lifetimebound]]">,
      InGroup<LifetimeSafetyCrossTUSuggestions>,
      DefaultIgnore;

def note_lifetime_safety_suggestion_returned_here : Note<"param returned here"
  "\n" "提示：形参在此处返回">;

def warn_lifetime_safety_noescape_escapes
    : Warning<"parameter is marked [[clang::noescape]] but escapes"
  "\n" "警告：形参被标记为 [[clang::noescape]] 但会逃逸">,
      InGroup<LifetimeSafetyNoescape>,
      DefaultIgnore;

// For non-floating point, expressions of the form x == x or x != x
// should result in a warning, since these always evaluate to a constant.
// Array comparisons have similar warnings
def warn_comparison_always : Warning<
  "%select{self-|array |pointer }0comparison always evaluates to "
  "%select{a constant|true|false|'std::strong_ordering::equal'}1"
  "\n" "警告：%select{自身|数组 |指针 }0比较始终求值为 "
  "%select{常量|true|false|'std::strong_ordering::equal'}1">,
  InGroup<TautologicalCompare>;
def warn_comparison_bitwise_always : Warning<
  "bitwise comparison always evaluates to %select{false|true}0"
  "\n" "警告：按位比较始终求值为 %select{false|true}0">,
  InGroup<TautologicalBitwiseCompare>, DefaultIgnore;
def warn_comparison_bitwise_or : Warning<
  "bitwise or with non-zero value always evaluates to true"
  "\n" "警告：与非零值进行按位或始终求值为 true">,
  InGroup<TautologicalBitwiseCompare>, DefaultIgnore;
def warn_tautological_negation_and_compare: Warning<
  "'&&' of a value and its negation always evaluates to false"
  "\n" "警告：值与其否定形式的 '&&' 始终求值为 false">,
  InGroup<TautologicalNegationCompare>, DefaultIgnore;
def warn_tautological_negation_or_compare: Warning<
  "'||' of a value and its negation always evaluates to true"
  "\n" "警告：值与其否定形式的 '||' 始终求值为 true">,
  InGroup<TautologicalNegationCompare>, DefaultIgnore;
def warn_tautological_overlap_comparison : Warning<
  "%select{non-|}0overlapping comparisons always evaluate to %select{false|true}0"
  "\n" "警告：%select{非|}0重叠比较始终求值为 %select{false|true}0">,
  InGroup<TautologicalOverlapCompare>, DefaultIgnore;
def warn_depr_array_comparison : Warning<
  "comparison between two arrays is deprecated; "
  "to compare array addresses, use unary '+' to decay operands to pointers"
  "\n" "警告：两个数组之间的比较已弃用； "
  "要比较数组地址，请使用一元 '+' 将操作数退化为指针">,
  InGroup<DeprecatedArrayCompare>;

def warn_array_comparison : Warning<
  "comparison between two arrays compare their addresses and will be deprecated in c++20; "
  "to compare array addresses, use unary '+' to decay operands to pointers"
  "\n" "警告：两个数组之间的比较比较的是它们的地址，并将在 c++20 中弃用； "
  "要比较数组地址，请使用一元 '+' 将操作数退化为指针">,
  InGroup<DiagGroup<"array-compare">>;

def warn_array_comparison_cxx26 : Warning<
  "comparison between two arrays is ill-formed in C++26; "
  "to compare array addresses, use unary '+' to decay operands to pointers"
  "\n" "警告：两个数组之间的比较在 C++26 中是不良形成的； "
  "要比较数组地址，请使用一元 '+' 将操作数退化为指针">,
  InGroup<DiagGroup<"array-compare-cxx26">>, DefaultError;

def warn_stringcompare : Warning<
  "result of comparison against %select{a string literal|@encode}0 is "
  "unspecified (use an explicit string comparison function instead)"
  "\n" "警告：与%select{字符串字面量|@encode}0比较的结果是 "
  "未指定的（请改用显式字符串比较函数）">,
  InGroup<StringCompare>;

def warn_identity_field_assign : Warning<
  "assigning %select{field|instance variable}0 to itself"
  "\n" "警告：将%select{字段|实例变量}0赋值给其自身">,
  InGroup<SelfAssignmentField>;

// Type safety attributes
def err_type_tag_for_datatype_not_ice : Error<
  "'type_tag_for_datatype' attribute requires the initializer to be "
  "an %select{integer|integral}0 constant expression"
  "\n" "错误：'type_tag_for_datatype' 特性要求初始化器是 "
  "%select{整数|整型}0常量表达式">;
def err_type_tag_for_datatype_too_large : Error<
  "'type_tag_for_datatype' attribute requires the initializer to be "
  "an %select{integer|integral}0 constant expression "
  "that can be represented by a 64 bit integer"
  "\n" "错误：'type_tag_for_datatype' 特性要求初始化器是 "
  "%select{整数|整型}0常量表达式 "
  "并且可以由 64 位整数表示">;
def err_tag_index_out_of_range : Error<
  "%select{type tag|argument}0 index %1 is greater than the number of arguments specified"
  "\n" "错误：%select{类型标签|实参}0索引 %1 大于指定的实参数量">;
def warn_type_tag_for_datatype_wrong_kind : Warning<
  "this type tag was not designed to be used with this function"
  "\n" "警告：此类型标签并非为此函数设计的">,
  InGroup<TypeSafety>;
def warn_type_safety_type_mismatch : Warning<
  "argument type %0 doesn't match specified %1 type tag "
  "%select{that requires %3|}2"
  "\n" "警告：实参类型 %0 与指定的 %1 类型标签不匹配 "
  "%select{，该标签需要 %3|}2">,
  InGroup<TypeSafety>;
def warn_type_safety_null_pointer_required : Warning<
  "specified %0 type tag requires a null pointer"
  "\n" "警告：指定的 %0 类型标签要求空指针">,
  InGroup<TypeSafety>;

// Generic selections.
def ext_assoc_type_incomplete : Extension<
  "incomplete type %0 in a '_Generic' association is a C2y extension"
  "\n" "警告：在 '_Generic' 关联中使用不完整类型 %0 是 C2y 扩展">,
  InGroup<C2y>;
def warn_c2y_compat_assoc_type_incomplete : Warning<
  "use of incomplete type %0 in a '_Generic' association is incompatible with "
  "C standards before C2y"
  "\n" "警告：在 '_Generic' 关联中使用不完整类型 %0 与 "
  "C2y 之前的 C 标准不兼容">,
  InGroup<CPre2yCompat>, DefaultIgnore;
def err_assoc_type_nonobject : Error<
  "type %0 in generic association not an object type"
  "\n" "错误：通用关联中的类型 %0 不是对象类型">;
def err_assoc_type_variably_modified : Error<
  "type %0 in generic association is a variably modified type"
  "\n" "错误：通用关联中的类型 %0 是可变修改类型">;
def err_assoc_compatible_types : Error<
  "type %0 in generic association compatible with previously specified type %1"
  "\n" "错误：通用关联中的类型 %0 与先前指定的类型 %1 兼容">;
def note_compat_assoc : Note<
  "compatible type %0 specified here"
  "\n" "提示：兼容类型 %0 在此指定">;
def err_generic_sel_no_match : Error<
  "controlling expression type %0 not compatible with any generic association type"
  "\n" "错误：控制表达式类型 %0 与任何通用关联类型都不兼容">;
def err_generic_sel_multi_match : Error<
  "controlling expression type %0 compatible with %1 generic association types"
  "\n" "错误：控制表达式类型 %0 与 %1 个通用关联类型兼容">;


// Blocks
def err_blocks_disable : Error<"blocks support disabled - compile with -fblocks"
  " or %select{pick a deployment target that supports them|for OpenCL C 2.0"
  " or OpenCL C 3.0 with __opencl_c_device_enqueue feature}0"
  "\n" "错误：blocks 支持已禁用 - 使用 -fblocks 编译"
  " 或%select{选择支持它们的部署目标|针对 OpenCL C 2.0"
  " 或带 __opencl_c_device_enqueue 特性的 OpenCL C 3.0}0">;
def err_block_returning_array_function : Error<
  "block cannot return %select{array|function}0 type %1"
  "\n" "错误：块不能返回%select{数组|函数}0类型 %1">;

// Builtin annotation
def err_builtin_annotation_first_arg : Error<
  "first argument to __builtin_annotation must be an integer"
  "\n" "错误：__builtin_annotation 的第一个实参必须是整数">;
def err_builtin_annotation_second_arg : Error<
  "second argument to __builtin_annotation must be a non-wide string constant"
  "\n" "错误：__builtin_annotation 的第二个实参必须是非宽字符串常量">;
