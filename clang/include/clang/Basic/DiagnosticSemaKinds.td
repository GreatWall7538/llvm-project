def err_hidden_device_kernel
    : Error<"%0 is specified as a device kernel but it is not externally visible"
    "\n" "错误：%0 被指定为设备内核，但它不是外部可见的">;

// Thread Safety Attributes
def warn_thread_attribute_ignored : Warning<
  "ignoring %0 attribute because its argument is invalid"
  "\n" "警告：忽略 %0 特性，因为其实参无效">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_not_on_non_static_member : Warning<
  "%0 attribute without capability arguments can only be applied to non-static "
  "methods of a class"
  "\n" "警告：没有能力实参的 %0 特性只能应用于类的非静态"
  "方法">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_not_on_capability_member : Warning<
  "%0 attribute without capability arguments refers to 'this', but %1 isn't "
  "annotated with 'capability' or 'scoped_lockable' attribute"
  "\n" "警告：没有能力实参的 %0 特性引用 'this'，但 %1 没有"
  "用 'capability' 或 'scoped_lockable' 特性注释">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_argument_not_lockable : Warning<
  "%0 attribute requires arguments whose type is annotated "
  "with 'capability' attribute; type here is %1"
  "\n" "警告：%0 特性要求其类型用 'capability' 特性注释的实参；此处的类型是 %1">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_decl_not_lockable : Warning<
  "%0 attribute can only be applied in a context annotated "
  "with 'capability' attribute"
  "\n" "警告：%0 特性只能在用 'capability' 特性注释的上下文中应用">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_decl_not_pointer : Warning<
  "%0 only applies to pointer types; type here is %1"
  "\n" "警告：%0 仅适用于指针类型；此处的类型是 %1">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_not_on_scoped_lockable_param : Warning<
  "%0 attribute applies to function parameters only if their type is a "
  "reference to a 'scoped_lockable'-annotated type"
  "\n" "警告：%0 特性仅在函数参数的类型是"
  "对 'scoped_lockable' 注释类型的引用时才适用">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_requires_preceded : Warning<
  "%0 attribute on %1 must be preceded by %2 attribute"
  "\n" "警告：%1 上的 %0 特性必须由 %2 特性先导">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def warn_thread_attribute_not_on_fun_ptr : Warning<
  "%0 attribute on a %select{variable|field}1 requires the %select{variable|field}1 to be of function pointer type"
  "\n" "警告：%select{变量|字段}1上的 %0 特性要求%select{变量|字段}1为函数指针类型">,
  InGroup<ThreadSafetyAttributes>, DefaultIgnore;
def err_attribute_argument_out_of_bounds_extra_info : Error<
  "%0 attribute parameter %1 is out of bounds: "
  "%plural{0:no parameters to index into|"
  "1:can only be 1, since there is one parameter|"
  ":must be between 1 and %2}2"
  "\n" "错误：%0 特性参数 %1 超出范围："
  "%plural{0:没有可索引的参数|"
  "1:只能是 1，因为只有一个参数|"
  ":必须介于 1 和 %2 之间}2">;

// Thread Safety Analysis
def warn_unlock_but_no_lock : Warning<"releasing %0 '%1' that was not held"
  "\n" "警告：释放未持有的 %0 '%1'">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_unlock_kind_mismatch : Warning<
  "releasing %0 '%1' using %select{shared|exclusive}2 access, expected "
  "%select{shared|exclusive}3 access"
  "\n" "警告：使用%select{共享|独占}2访问释放 %0 '%1'，预期"
  "%select{共享|独占}3访问">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_double_lock : Warning<"acquiring %0 '%1' that is already held"
  "\n" "警告：获取已持有的 %0 '%1'">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_no_unlock : Warning<
  "%0 '%1' is still held at the end of function"
  "\n" "警告：%0 '%1' 在函数结束时仍被持有">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_expecting_locked : Warning<
  "expecting %0 '%1' to be held at the end of function"
  "\n" "警告：预期 %0 '%1' 在函数结束时被持有">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
// FIXME: improve the error message about locks not in scope
def warn_lock_some_predecessors : Warning<
  "%0 '%1' is not held on every path through here%select{| with equal reentrancy depth}2"
  "\n" "警告：%0 '%1' 并未在通过此处的每条路径上都持有%select{|且具有相等的重入深度}2">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_expecting_lock_held_on_loop : Warning<
  "expecting %0 '%1' to be held at start of each loop%select{| with equal reentrancy depth}2"
  "\n" "警告：预期 %0 '%1' 在每层循环开始时都被持有%select{|且具有相等的重入深度}2">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def note_locked_here : Note<"%0 acquired here"
  "\n" "提示：%0 在此获取">;
def note_unlocked_here : Note<"%0 released here"
  "\n" "提示：%0 在此释放">;
def warn_lock_exclusive_and_shared : Warning<
  "%0 '%1' is acquired exclusively and shared in the same scope"
  "\n" "警告：%0 '%1' 在同一作用域中被独占获取并共享">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def note_lock_exclusive_and_shared : Note<
  "the other acquisition of %0 '%1' is here"
  "\n" "提示：对 %0 '%1' 的另一次获取在此">;
def warn_variable_requires_any_lock : Warning<
  "%select{reading|writing}1 variable %0 requires holding "
  "%select{any mutex|any mutex exclusively}1"
  "\n" "警告：%select{读取|写入}1变量 %0 需要持有"
  "%select{任何互斥锁|任何独占互斥锁}1">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_var_deref_requires_any_lock : Warning<
  "%select{reading|writing}1 the value pointed to by %0 requires holding "
  "%select{any mutex|any mutex exclusively}1"
  "\n" "警告：%select{读取|写入}1%0 指向的值需要持有"
  "%select{任何互斥锁|任何独占互斥锁}1">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_requires_any_of_locks : Warning<
  "reading %select{variable|the value pointed to by}1 %0 requires holding "
  "at least one of %2"
  "\n" "警告：读取%select{变量|%0 指向的值}1需要持有 "
  "%2 中的至少一个">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_fun_excludes_mutex : Warning<
  "cannot call function '%1' while %0 '%2' is held"
  "\n" "警告：持有 %0 '%2' 时不能调用函数 '%1'">,
  InGroup<ThreadSafetyAnalysis>, DefaultIgnore;
def warn_cannot_resolve_lock : Warning<
  "cannot resolve lock expression"
  "\n" "警告：无法解析锁表达式">,
