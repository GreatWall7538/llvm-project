  "\n" "错误：使用可能 direct 的方法向 Class 发送消息">;

// C++ declarations
def err_static_assert_expression_is_not_constant : Error<
  "static assertion expression is not an integral constant expression"
  "\n" "错误：static assertion 表达式不是整数常量表达式">;
def err_constexpr_if_condition_expression_is_not_constant : Error<
  "constexpr if condition is not a constant expression"
  "\n" "错误：constexpr if 条件不是常量表达式">;
def err_static_assert_failed : Error<"static assertion failed%select{: %1|}0"
  "\n" "错误：static assertion 失败%select{：%1|}0">;
def err_static_assert_requirement_failed : Error<
  "static assertion failed due to requirement '%0'%select{: %2|}1"
  "\n" "错误：static assertion 因要求 '%0' 失败%select{：%2|}1">;
def note_expr_evaluates_to : Note<
  "expression evaluates to '%0 %1 %2'"
  "\n" "提示：表达式求值为 '%0 %1 %2'">;


def subst_user_defined_msg : TextSubstitution<
  "%select{the message|the expression}0 in "
  "%select{a static assertion|this asm operand}0"
  "\n" "%select{消息|表达式}0 "
  "%select{在 static assertion 中|在此 asm 操作数中}0">;

def err_user_defined_msg_invalid : Error<
  "%sub{subst_user_defined_msg}0 must be a string literal or an "
  "object with 'data()' and 'size()' member functions"
  "\n" "错误：%sub{subst_user_defined_msg}0必须是字符串字面量或具有 "
  "'data()' 和 'size()' 成员函数的对象">;
def err_user_defined_msg_missing_member_function : Error<
  "the %select{message|string}0 object in "
  "%select{this static assertion|this asm operand}0 is missing %select{"
  "a 'size()' member function|"
  "a 'data()' member function|"
  "'data()' and 'size()' member functions}1"
  "\n" "错误：%select{此 static assertion|此 asm 操作数}0中的%select{消息|字符串}0对象缺少%select{"
  "'size()' 成员函数|"
  "'data()' 成员函数|"
  "'data()' 和 'size()' 成员函数}1">;
def err_user_defined_msg_invalid_mem_fn_ret_ty : Error<
  "%sub{subst_user_defined_msg}0 must have a '%select{size|data}1()' member "
  "function returning an object convertible to '%select{std::size_t|const char *}1'"
  "\n" "错误：%sub{subst_user_defined_msg}0必须具有返回可转换为 '%select{std::size_t|const char *}1' 的对象的 '%select{size|data}1()' 成员函数">;
def warn_user_defined_msg_constexpr : Warning<
  "%select{the message|the expression}0 in "
  "%select{this static assertion|this asm operand}0 is not a constant expression"
  "\n" "警告：%select{此 static assertion|此 asm 操作数}0中的%select{消息|表达式}0不是常量表达式">,
  DefaultError, InGroup<DiagGroup<"invalid-static-assert-message">>;
def err_user_defined_msg_constexpr : Error<
  "%sub{subst_user_defined_msg}0 must be produced by a "
  "constant expression"
  "\n" "错误：%sub{subst_user_defined_msg}0必须由常量表达式产生">;

// Type traits explanations
def note_unsatisfied_trait
    : Note<"%0 is not %enum_select<TraitName>{"
           "%TriviallyRelocatable{trivially relocatable}|"
           "%TriviallyCopyable{trivially copyable}|"
           "%Empty{empty}|"
           "%StandardLayout{standard-layout}|"
           "%Aggregate{aggregate}|"
           "%Final{final}|"
           "%Abstract{abstract}"
           "}1"
           "\n" "提示：%0 不是%enum_select<TraitName>{"
           "%TriviallyRelocatable{可平凡重定位}|"
           "%TriviallyCopyable{可平凡复制}|"
           "%Empty{空}|"
           "%StandardLayout{标准布局}|"
           "%Aggregate{聚合体}|"
           "%Final{final}|"
           "%Abstract{抽象}"
           "}1">;

def note_unsatisfied_trait_reason
    : Note<"because it "
           "%enum_select<TraitNotSatisfiedReason>{"
           "%Ref{is a reference type}|"
           "%Const{is const}|"
           "%Volatile{is volatile}|"
           "%HasArcLifetime{has an ARC lifetime qualifier}|"
           "%VLA{is a variably-modified type}|"
           "%VBase{has a virtual base %1}|"
           "%NotScalarOrClass{is not %select{a|an array of objects of}1 scalar or "
           "class type}|"
           "%NTRBase{has a non-trivially-relocatable base %1}|"
           "%NTRField{has a non-trivially-relocatable member %1 of type %2}|"
           "%NTCBase{has a non-trivially-copyable base %1}|"
           "%NTCField{has a non-trivially-copyable member %1 of type %2}|"
           "%NonEmptyMember{has a non-static data member %1 of type %2}|"
           "%PolymorphicType{is a polymorphic type}|"
           "%VirtualFunction{has a virtual function %1}|"
           "%NonEmptyBase{has a base class %1 that is not empty}|"
           "%NonZeroLengthField{field %1 is a non-zero-length bit-field}|"
           "%NonStandardLayoutBase{has a non-standard-layout base %1}|"
           "%MixedAccess{has mixed access specifiers}|"
           "%MixedAccessField{field %1 has a different access specifier than field %2}|"
           "%MultipleDataBase{has multiple base classes with data members}|"
           "%NonStandardLayoutMember{has a non-standard-layout member %1 of type %2}|"
           "%IndirectBaseWithFields{has an indirect base %1 with data members}|"
           "%DeletedDtr{has a %select{deleted|user-provided}1 destructor}|"
           "%UserProvidedCtr{has a user provided %select{copy|move}1 "
           "constructor}|"
           "%UserDeclaredCtr{has a user-declared constructor}|"
           "%InheritedCtr{has an inherited constructor}|"
           "%DeletedCtr{has a deleted %select{copy|move}1 "
           "constructor}|"
           "%UserProvidedAssign{has a user provided %select{copy|move}1 "
           "assignment operator}|"
           "%DeletedAssign{has a deleted %select{copy|move}1 "
           "assignment operator}|"
           "%UnionWithUserDeclaredSMF{is a union with a user-declared "
           "%sub{select_special_member_kind}1}|"
           "%FunctionType{is a function type}|"
           "%CVVoidType{is a cv void type}|"
           "%IncompleteArrayType{is an incomplete array type}|"
           "%PrivateProtectedDirectDataMember{has a %select{private|protected}1 direct data member}|"
           "%PrivateProtectedDirectBase{has a %select{private|protected}1 direct base}|"
           "%NotClassOrUnion{is not a class or union type}|"
           "%NotMarkedFinal{is not marked 'final'}|"
           "%PointerType{is a pointer type}|"
           "%ArrayType{is an array type}|"
           "%UnionType{is a union type}|"
           "%NotStructOrClass{is not a struct or class type}|"
           "%OverridesAllPureVirtual{overrides all pure virtual functions from base class %1}"
           "}0"
           "\n" "提示：因为它"
           "%enum_select<TraitNotSatisfiedReason>{"
           "%Ref{是引用类型}|"
           "%Const{是 const}|"
           "%Volatile{是 volatile}|"
           "%HasArcLifetime{具有 ARC 生命周期限定符}|"
           "%VLA{是可变修改类型}|"
           "%VBase{具有虚拟基类 %1}|"
           "%NotScalarOrClass{不是%select{标量|对象数组的}1标量或 "
           "类类型}|"
           "%NTRBase{具有不可平凡重定位的基类 %1}|"
           "%NTRField{具有类型为 %2 的不可平凡重定位成员 %1}|"
           "%NTCBase{具有不可平凡复制的基类 %1}|"
           "%NTCField{具有类型为 %2 的不可平凡复制成员 %1}|"
           "%NonEmptyMember{具有类型为 %2 的非静态数据成员 %1}|"
           "%PolymorphicType{是多态类型}|"
           "%VirtualFunction{具有虚拟函数 %1}|"
           "%NonEmptyBase{具有非空的基类 %1}|"
           "%NonZeroLengthField{字段 %1 是非零长度的位域}|"
           "%NonStandardLayoutBase{具有非标准布局的基类 %1}|"
           "%MixedAccess{具有混合的访问说明符}|"
           "%MixedAccessField{字段 %1 具有与字段 %2 不同的访问说明符}|"
           "%MultipleDataBase{具有多个带数据成员的基类}|"
           "%NonStandardLayoutMember{具有类型为 %2 的非标准布局成员 %1}|"
           "%IndirectBaseWithFields{具有带数据成员的间接基类 %1}|"
           "%DeletedDtr{具有%select{删除的|用户提供的}1析构函数}|"
           "%UserProvidedCtr{具有用户提供的%select{复制|移动}1 "
           "构造函数}|"
           "%UserDeclaredCtr{具有用户声明的构造函数}|"
           "%InheritedCtr{具有继承的构造函数}|"
           "%DeletedCtr{具有删除的%select{复制|移动}1 "
           "构造函数}|"
           "%UserProvidedAssign{具有用户提供的%select{复制|移动}1 "
           "赋值运算符}|"
           "%DeletedAssign{具有删除的%select{复制|移动}1 "
           "赋值运算符}|"
           "%UnionWithUserDeclaredSMF{是具有用户声明的"
           "%sub{select_special_member_kind}1的联合}|"
           "%FunctionType{是函数类型}|"
           "%CVVoidType{是 cv void 类型}|"
           "%IncompleteArrayType{是不完整的数组类型}|"
           "%PrivateProtectedDirectDataMember{具有%select{私有|受保护}1的直接数据成员}|"
           "%PrivateProtectedDirectBase{具有%select{私有|受保护}1的直接基类}|"
           "%NotClassOrUnion{不是类或联合类型}|"
           "%NotMarkedFinal{未标记为 'final'}|"
           "%PointerType{是指针类型}|"
           "%ArrayType{是数组类型}|"
           "%UnionType{是联合类型}|"
           "%NotStructOrClass{不是 struct 或 class 类型}|"
           "%OverridesAllPureVirtual{覆盖了基类 %1 的所有纯虚函数}"
           "}0">;

def warn_consteval_if_always_true : Warning<
  "consteval if is always true in an %select{unevaluated|immediate}0 context"
  "\n" "警告：consteval if 在%select{未求值|立即}0上下文中总是为真">,
  InGroup<DiagGroup<"redundant-consteval-if">>;

def warn_inline_namespace_reopened_noninline : Warning<
  "inline namespace reopened as a non-inline namespace"
  "\n" "警告：inline 命名空间作为非 inline 命名空间重新打开">,
  InGroup<InlineNamespaceReopenedNoninline>;
def err_inline_namespace_mismatch : Error<
  "non-inline namespace cannot be reopened as inline"
  "\n" "错误：非 inline 命名空间不能作为 inline 重新打开">;
def err_inline_namespace_std : Error<
  "cannot declare the namespace 'std' to be inline"
  "\n" "错误：不能将命名空间 'std' 声明为 inline">;

def err_unexpected_friend : Error<
  "friends can only be classes or functions"
  "\n" "错误：friend 只能是类或函数">;
def ext_enum_friend : ExtWarn<
  "elaborated enum specifier cannot be declared as a friend"
  "\n" "警告：elaborated 枚举说明符不能声明为 friend">,
  InGroup<DiagGroup<"friend-enum">>;
def note_enum_friend : Note<
  "remove 'enum%select{| struct| class}0' to befriend an enum"
  "\n" "提示：移除 'enum%select{| struct| class}0' 以使枚举成为 friend">;
def err_friend_is_member : Error<
  "friends cannot be members of the declaring class"
  "\n" "错误：friend 不能是声明类的成员">;
def warn_cxx98_compat_friend_is_member : Warning<
  "friend declaration naming a member of the declaring class is incompatible "
  "with C++98"
  "\n" "警告：命名声明类成员的 friend 声明与 C++98 不兼容">, InGroup<CXX98Compat>, DefaultIgnore;
