  " %select{指针|非 const|可重定位|相同类型}0">;

def err_builtin_matrix_disabled: Error<
  "matrix types extension is disabled. Pass -fenable-matrix to enable it"
  "\n" "错误：矩阵类型扩展已禁用。传递 -fenable-matrix 以启用它">;
