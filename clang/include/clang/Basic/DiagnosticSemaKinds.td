  "\n" "错误：%0 维度超出允许范围 [1, %1]">;
def err_builtin_matrix_invalid_member
    : Error<"invalid matrix member '%0' expected %1"
    "\n" "错误：无效的矩阵成员 '%0'，期望 %1">;

