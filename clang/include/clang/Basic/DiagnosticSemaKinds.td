  "first argument to __builtin_call_with_static_chain must not be a builtin call"
  "\n" "错误：__builtin_call_with_static_chain 的第一个实参不能是内建调用">;
def err_first_argument_to_cwsc_pdtor_call : Error<
  "first argument to __builtin_call_with_static_chain must not be a pseudo-destructor call"
  "\n" "错误：__builtin_call_with_static_chain 的第一个实参不能是伪析构函数调用">;
def err_second_argument_to_cwsc_not_pointer : Error<
  "second argument to __builtin_call_with_static_chain must be of pointer type"
  "\n" "错误：__builtin_call_with_static_chain 的第二个实参必须是指针类型">;

def err_vector_incorrect_num_elements : Error<
  "%select{too many|too few}0 elements in vector %select{initialization|operand}3 (expected %1 elements, have %2)"
  "\n" "错误：向量%select{初始化|操作数}3中%select{过多|过少}0个元素（期望 %1 个元素，有 %2 个）">;
def err_altivec_empty_initializer : Error<"expected initializer"
  "\n" "错误：期望初始化器">;

def err_vector_incorrect_bit_count : Error<
  "incorrect number of bits in vector operand (expected %select{|a multiple of}0 %1 bits, have %2)"
  "\n" "错误：向量操作数中的位数不正确（期望%select{|}0 %1 的倍数位，有 %2 位）">;
def err_integer_incorrect_bit_count : Error<
  "incorrect number of bits in integer (expected %0 bits, have %1)"
  "\n" "错误：整数中的位数不正确（期望 %0 位，有 %1 位）">;

