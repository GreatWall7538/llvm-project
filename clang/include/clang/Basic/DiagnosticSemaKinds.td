def warn_unused_variable : Warning<"unused variable %0"
  "\n" "警告：未使用的变量 %0">,
  InGroup<UnusedVariable>, DefaultIgnore;
def warn_unused_but_set_variable : Warning<"variable %0 set but not used"
  "\n" "警告：变量 %0 被设置但未使用">,
  InGroup<UnusedButSetVariable>, DefaultIgnore;
